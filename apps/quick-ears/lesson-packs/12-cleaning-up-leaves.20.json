[{"answer":"The leaves are changing colors.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/1.mp3"},{"answer":"I see red maple leaves.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/2.mp3"},{"answer":"I see orange maple leaves.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/3.mp3"},{"answer":"I see yellow maple leaves.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/4.mp3"},{"answer":"The leaves are beautiful.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/5.mp3"},{"answer":"It is starting to get cold.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/6.mp3"},{"answer":"The wind is strong.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/7.mp3"},{"answer":"Winter is coming.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/8.mp3"},{"answer":"The leaves fall off the trees.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/9.mp3"},{"answer":"On Saturday we will clean them up.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/10.mp3"},{"answer":"The whole family helps.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/11.mp3"},{"answer":"My dad gets the rake.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/12.mp3"},{"answer":"My mom gets the garbage bags.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/13.mp3"},{"answer":"My brother and I help too.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/14.mp3"},{"answer":"We gather leaves with our hands.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/15.mp3"},{"answer":"We make a big pile.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/16.mp3"},{"answer":"My brother and I jump in the leaves.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/17.mp3"},{"answer":"We make a big mess.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/18.mp3"},{"answer":"Our parents don't mind.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/19.mp3"},{"answer":"Our parents fill our coats with leaves.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/20.mp3"},{"answer":"We look really big.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/21.mp3"},{"answer":"Everyone laughs.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/22.mp3"},{"answer":"Play time is over.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/23.mp3"},{"answer":"Back to work.","audio":"https://dailydictation.com/upload/general-english/12-cleaning-up-leaves-2019-03-20-00-03-18/24.mp3"}]
