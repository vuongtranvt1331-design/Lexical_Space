[{"answer":"Good morning. Perhaps you can advise me...","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/1.mp3"},{"answer":"Yes, ma'am.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/2.mp3"},{"answer":"I'm looking for a toy for my niece.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/3.mp3"},{"answer":"Oh, yes... how old is she?","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/4.mp3"},{"answer":"She'll be seven years old on Sunday.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/5.mp3"},{"answer":"Skateboards are still very popular.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/6.mp3"},{"answer":"Hmm, I don't want her to hurt herself.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/7.mp3"},{"answer":"What about a Barbie Doll set?","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/8.mp3"},{"answer":"I don't think so. She has many Barbie Dolls.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/9.mp3"},{"answer":"Have you got anything educational?","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/10.mp3"},{"answer":"You see, she's a very intelligent girl.","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/11.mp3"},{"answer":"I've got the perfect thing!","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/12.mp3"},{"answer":"A do-it-yourself kit where you can build your own Barbie Doll who rides a skateboard!","audio":"https://dailydictation.com/upload/english-conversations/79-buying-a-present---in-a-toy-shop-2022-03-07-21-30-20/13.mp3"}]
