[{"answer":"Do you like snow?","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/1.mp3"},{"answer":"No! I hate it!","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/2.mp3"},{"answer":"Why? Snow is so pretty.","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/3.mp3"},{"answer":"Yes, but I don't like to drive in it.","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/4.mp3"},{"answer":"Well, it's beginning to snow.","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/5.mp3"},{"answer":"And I have to drive to work.","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/6.mp3"},{"answer":"How far is it to work?","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/7.mp3"},{"answer":"Six miles. Are we going to get much snow?","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/8.mp3"},{"answer":"About twelve inches, they say.","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/9.mp3"},{"answer":"Oh no! Driving will be dangerous!","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/10.mp3"},{"answer":"Please be careful!","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/11.mp3"},{"answer":"I will, by the way, can I borrow your car?","audio":"https://dailydictation.com/upload/english-conversations/51-its-beginning-to-snow-2022-03-07-21-21-47/12.mp3"}]
