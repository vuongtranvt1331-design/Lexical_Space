[{"answer":"Diana!","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/1.mp3"},{"answer":"Oh, George... hi, how are you?","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/2.mp3"},{"answer":"Listen, I'm in a terrible hurry.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/3.mp3"},{"answer":"The bank closes in twenty minutes.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/4.mp3"},{"answer":"Is your bank near here?","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/5.mp3"},{"answer":"Yes, it's only four blocks away, on Vine Street.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/6.mp3"},{"answer":"Well, get in. I'll take you.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/7-2022-03-09-22-03-59.mp3"},{"answer":"Are you sure? It's not out of your way?","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/8.mp3"},{"answer":"No, not at all.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/9.mp3"},{"answer":"That is so nice of you, George. Thank you.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/10.mp3"},{"answer":"You're welcome.","audio":"https://dailydictation.com/upload/english-conversations/66-ill-take-you-2022-03-07-21-26-45/11.mp3"}]
