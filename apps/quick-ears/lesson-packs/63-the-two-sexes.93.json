[{"answer":"There are two sexes or genders.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/1.mp3"},{"answer":"There is the male gender, and there is the female gender.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/2.mp3"},{"answer":"Males and females are different, both physically and mentally.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/3.mp3"},{"answer":"Humans are both male and female, and animals are both male and female.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/4.mp3"},{"answer":"If you have a dog, it is either a girl dog or a boy dog.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/5.mp3"},{"answer":"Boys grow up to be men.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/6.mp3"},{"answer":"Men grow hair on their faces.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/7.mp3"},{"answer":"Men are usually more muscular than women.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/8.mp3"},{"answer":"Men dress differently than women.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/9.mp3"},{"answer":"Men are males. Males are masculine.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/10.mp3"},{"answer":"Girls grow up to be women.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/11.mp3"},{"answer":"Only women can have babies.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/12.mp3"},{"answer":"Women are females. Females are feminine.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/13.mp3"},{"answer":"Another word for women is ladies.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/14.mp3"},{"answer":"It is good that we have males and females.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/15.mp3"},{"answer":"Your father is a male.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/16.mp3"},{"answer":"Your grandfather, brother and uncle are males.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/17.mp3"},{"answer":"Your mother is a female.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/18.mp3"},{"answer":"Your grandmother, sister and aunt are females.","audio":"https://dailydictation.com/upload/general-english/63-the-two-sexes-2019-03-29-12-41-47/19.mp3"}]
