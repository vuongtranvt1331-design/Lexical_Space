[{"answer":"Hi! Sorry I'm late. I missed the bus.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/1.mp3"},{"answer":"Oh, that's OK. I had time to clean up before you came.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/2.mp3"},{"answer":"You don't look very good.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/3.mp3"},{"answer":"I must be getting a cold. I've been sneezing all day.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/4.mp3"},{"answer":"A-A-ATCHOO!","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/5.mp3"},{"answer":"Bless you.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/6.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/7.mp3"},{"answer":"You must be getting a cold.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/8.mp3"},{"answer":"Why don't you go lie down? I'll bring you some aspirin.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/9.mp3"},{"answer":"I don't see any aspirin in the medicine cabinet.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/10.mp3"},{"answer":"We must be out of them.","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/11.mp3"},{"answer":"I'll go to the drugstore. Is there anything else we need?","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/12.mp3"},{"answer":"Could you get some... ATCHOO...","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/13.mp3"},{"answer":"I don't know if they sell ATCHOO here, but I'll check!","audio":"https://dailydictation.com/upload/english-conversations/67-we-must-be-out-of-them-2022-03-07-21-27-01/14.mp3"}]
