[{"answer":"Red is a vibrant color.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/1.mp3"},{"answer":"Roses are sometimes red.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/2.mp3"},{"answer":"Blood is red.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/3.mp3"},{"answer":"White is the color of snow.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/4.mp3"},{"answer":"Clouds are very often white.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/5.mp3"},{"answer":"Blue is the color of the sky and the ocean.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/6.mp3"},{"answer":"Black isn't really a color at all.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/7.mp3"},{"answer":"Tar is black, a crow is black.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/8.mp3"},{"answer":"Green is the color of grass.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/9.mp3"},{"answer":"It is also the color of leaves on the trees in the summer.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/10.mp3"},{"answer":"Brown is the color of dirt.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/11.mp3"},{"answer":"Many people have brown hair.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/12.mp3"},{"answer":"Yellow is a bright color.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/13.mp3"},{"answer":"Most people use yellow when they draw a picture of the sun.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/14-2025-05-31-15-55-19.mp3"},{"answer":"Orange is an easy color to remember,","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/16.mp3"},{"answer":"that is because an orange is orange.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/17.mp3"},{"answer":"Pink is the color that we dress baby girls in.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/18.mp3"},{"answer":"We dress baby boys in blue.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/19.mp3"},{"answer":"Purple is the color of some violets.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/20.mp3"},{"answer":"The Canadian flag is red and white.","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/21.mp3"},{"answer":"What color is your flag?","audio":"https://dailydictation.com/upload/general-english/41-colors-2019-03-20-09-47-35/22.mp3"}]
