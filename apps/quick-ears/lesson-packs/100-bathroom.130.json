[{"answer":"There is a bathtub in my bathroom.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/1.mp3"},{"answer":"On the wall over the bathtub there is a shower head.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/2.mp3"},{"answer":"We have a shower curtain hanging on the rod over the bathtub.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/3.mp3"},{"answer":"If you want to take a shower, we close the curtain.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/4.mp3"},{"answer":"There is soap and shampoo in the bathroom.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/5.mp3"},{"answer":"The soap is used for washing yourself,","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/6.mp3"},{"answer":"and the shampoo is used to wash your hair.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/7.mp3"},{"answer":"Towels are hanging on the racks.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/8.mp3"},{"answer":"There are washcloths or face cloths to wash yourself with.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/9.mp3"},{"answer":"The sink has hot and cold taps.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/10.mp3"},{"answer":"There is a plug for the drain.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/11.mp3"},{"answer":"When you pull the plug, the water runs out of the sink.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/12.mp3"},{"answer":"There is a toilet in the bathroom.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/13.mp3"},{"answer":"When you flush the toilet,","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/14.mp3"},{"answer":"the water swooshes out of it.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/15.mp3"},{"answer":"There is toilet tissue hanging beside the toilet.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/16.mp3"},{"answer":"We keep other things in the bathroom too.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/17.mp3"},{"answer":"There is a medicine cabinet which holds pain killers, toothpaste and makeup.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/18.mp3"},{"answer":"My mother likes to wear a lot of makeup on her face.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/19.mp3"},{"answer":"There is also hair spray and gel.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/20.mp3"},{"answer":"There are brushes and combs for our hair.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/21.mp3"},{"answer":"There are toothbrushes and dental floss for our teeth.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/22.mp3"},{"answer":"We only have one bathroom, so we line up to use it.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/23.mp3"},{"answer":"It is good to have more than one bathroom in a house.","audio":"https://dailydictation.com/upload/general-english/100-bathroom-2019-04-07-03-53-27/24.mp3"}]
