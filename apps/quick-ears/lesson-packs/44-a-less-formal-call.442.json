[{"answer":"Good afternoon, Scott and Smith. May I help you?","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/1.mp3"},{"answer":"May I speak to Mr. Scott or Mr. Smith, please?","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/2.mp3"},{"answer":"I'm sorry, they aren't here right now. Who's calling, please?","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/3.mp3"},{"answer":"George Martin.","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/4.mp3"},{"answer":"Is there any message I can take, Mr. Martin?","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/5.mp3"},{"answer":"No, I'll call back later.","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/6.mp3"},{"answer":"Thank you for calling Scott and Smith.","audio":"https://dailydictation.com/upload/english-conversations/44-a-less-formal-call-2022-03-07-21-19-50/7.mp3"}]
