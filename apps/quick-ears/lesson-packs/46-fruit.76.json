[{"answer":"Some fruit grows on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/1.mp3"},{"answer":"Apples grow on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/2.mp3"},{"answer":"You can get red, yellow or green apples.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/3.mp3"},{"answer":"Some apples are green until they ripen,","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/4.mp3"},{"answer":"then they turn red.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/5.mp3"},{"answer":"Peaches grow on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/6.mp3"},{"answer":"Peaches have a fuzzy skin.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/7.mp3"},{"answer":"Cherries grow on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/8.mp3"},{"answer":"You can climb a ladder and pick cherries from the tree.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/9.mp3"},{"answer":"Cherries and peaches have pits inside them.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/10.mp3"},{"answer":"The pits are not edible.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/11.mp3"},{"answer":"Pears also grow on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/12.mp3"},{"answer":"Lemons grow on trees. They are very sour.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/13.mp3"},{"answer":"Have you ever picked strawberries?","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/14.mp3"},{"answer":"Strawberries do not grow on trees.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/15.mp3"},{"answer":"You have to bend down to pick strawberries.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/16.mp3"},{"answer":"Have you ever tried strawberry shortcake? It is very good.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/17.mp3"},{"answer":"Grapes grow on vines. People use grapes to make wine.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/18.mp3"},{"answer":"There are many types of berries. There are blackberries,","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/19.mp3"},{"answer":"blueberries, raspberries and cranberries, just to name a few.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/20.mp3"},{"answer":"Some fruits are more exotic.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/21.mp3"},{"answer":"There are mangoes and papayas.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/22.mp3"},{"answer":"They don't grow in Canada.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/23.mp3"},{"answer":"Bananas and oranges don't grow in a Canadian climate either,","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/24.mp3"},{"answer":"but we are able to buy them here.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/25.mp3"},{"answer":"Some fruits have to be peeled, and some can be eaten as they are.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/26.mp3"},{"answer":"It is always a good idea to wash fruit before you eat it.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/27.mp3"},{"answer":"The farmers spray the crops with pesticides to kill bugs,","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/28.mp3"},{"answer":"so it is good to wash that off.","audio":"https://dailydictation.com/upload/general-english/46-fruit-2019-03-29-10-18-05/29.mp3"}]
