[{"answer":"Are you married?","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/1.mp3"},{"answer":"No, I'm not. I'm single.","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/2.mp3"},{"answer":"Tell me about your new car. Is it large?","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/3.mp3"},{"answer":"No, it's not. It is small.","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/4.mp3"},{"answer":"Tell me about the questions in your English book.","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/5.mp3"},{"answer":"Are they difficult?","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/6.mp3"},{"answer":"No, they're not. They are easy.","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/7.mp3"},{"answer":"Tell me about your new neighbors?","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/8.mp3"},{"answer":"Are they quiet?","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/9.mp3"},{"answer":"No, they aren't. They are noisy.","audio":"https://dailydictation.com/upload/english-conversations/8-no-questions-2022-03-07-20-53-08/10.mp3"}]
