[{"answer":"Excuse me? Can you tell me the way to the nearest bank?","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/1.mp3"},{"answer":"Yes, it's on Geneva Street.","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/2.mp3"},{"answer":"As a matter of fact, I'm going that way myself.","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/3.mp3"},{"answer":"So if you come with me, I will show you.","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/4.mp3"},{"answer":"Thanks very much.","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/5.mp3"},{"answer":"You're welcome.","audio":"https://dailydictation.com/upload/english-conversations/5-location-2-2022-03-07-20-51-52/6.mp3"}]
