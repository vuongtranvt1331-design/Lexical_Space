[{"answer":"Which direction should I go in?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/1.mp3"},{"answer":"Should I go up?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/2.mp3"},{"answer":"If I go up, I will head toward the sky.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/3.mp3"},{"answer":"I can go up the stairs.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/4.mp3"},{"answer":"Should I go down?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/5.mp3"},{"answer":"I can go down the stairs to the basement.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/6.mp3"},{"answer":"I can climb down into a hole.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/7.mp3"},{"answer":"Should I go left or right?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/8.mp3"},{"answer":"I am right-handed, so I know which way right is.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/9.mp3"},{"answer":"Should I go backwards?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/10.mp3"},{"answer":"I would be going away from the things that I am facing now if I went backwards.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/11.mp3"},{"answer":"If I went backwards from the thing that I am facing,","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/12.mp3"},{"answer":"I would go away from it.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/13.mp3"},{"answer":"Should I go forward?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/14.mp3"},{"answer":"I will just go straight ahead if I go forward.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/15.mp3"},{"answer":"If I am facing something and I go forward,","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/16.mp3"},{"answer":"then I will go toward the thing that I am facing.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/17.mp3"},{"answer":"Maybe I should go sideways,","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/18.mp3"},{"answer":"but which side, left or right?","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/19.mp3"},{"answer":"It sounds very complicated, but it is not.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/20.mp3"},{"answer":"Directions are very easy to follow if you just stop and think about them.","audio":"https://dailydictation.com/upload/general-english/59-which-direction-2019-03-29-10-26-18/21.mp3"}]
