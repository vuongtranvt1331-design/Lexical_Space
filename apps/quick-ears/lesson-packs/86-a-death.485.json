[{"answer":"Did you hear about the Smith family?","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/1.mp3"},{"answer":"No, what happened?","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/2.mp3"},{"answer":"Mrs. Smith passed away this morning.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/3.mp3"},{"answer":"That's a shame. What from?","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/4.mp3"},{"answer":"Heart attack, I think.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/5.mp3"},{"answer":"That's a terrible thing.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/6.mp3"},{"answer":"Yes. Mrs Smith went into hospital last night by ambulance and died this morning.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/7.mp3"},{"answer":"Had she been suffering from heart disease?","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/8.mp3"},{"answer":"Yeah. Mrs Smith had it for five years before she died.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/9.mp3"},{"answer":"Did they try surgery?","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/10.mp3"},{"answer":"She had two operations, but they weren't effective.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/11.mp3"},{"answer":"I feel sorry for Mr. Smith.","audio":"https://dailydictation.com/upload/english-conversations/86-a-death-2022-03-07-21-34-13/12.mp3"}]
