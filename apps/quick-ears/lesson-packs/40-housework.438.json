[{"answer":"Whew! I'm really tired and now I have to go home and cook.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/1.mp3"},{"answer":"Do you make dinner every night?","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/2.mp3"},{"answer":"Yes, I usually make dinner, and my husband washes the dishes.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/3.mp3"},{"answer":"I live alone, so I do everything. Sometimes I eat out, though.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/4.mp3"},{"answer":"There are some good restaurants in my neighbourhood.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/5.mp3"},{"answer":"Where do you live?","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/6.mp3"},{"answer":"Near the Pen Centre.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/7.mp3"},{"answer":"Oh, that's good.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/8.mp3"},{"answer":"There aren't any good restaurants near my house.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/9.mp3"},{"answer":"Does your husband help you do housework much?","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/10.mp3"},{"answer":"Umm... yes. He sets the table almost every night, and he makes our bed every morning.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/11.mp3"},{"answer":"But I usually make all the meals.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/12.mp3"},{"answer":"How about cleaning?","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/13.mp3"},{"answer":"We clean the house together every weekend.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/14.mp3"},{"answer":"I vacuum the rooms, and he usually sweeps the floor of the kitchen,","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/15.mp3"},{"answer":"and he does yard work.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/16.mp3"},{"answer":"Your husband helps you so much. Does he help do the laundry too?","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/17.mp3"},{"answer":"Well, he's never helped me do the laundry.","audio":"https://dailydictation.com/upload/english-conversations/40-housework-2022-03-07-21-18-18/18.mp3"}]
