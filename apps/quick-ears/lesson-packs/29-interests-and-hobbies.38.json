[{"answer":"It is very rewarding to have different interests and hobbies.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/1.mp3"},{"answer":"Some people like to play computer games.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/2.mp3"},{"answer":"Other people spend a lot of time watching television.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/3.mp3"},{"answer":"There are people who would rather watch movies.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/4.mp3"},{"answer":"Some people prefer more physical things.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/5.mp3"},{"answer":"They would rather play a sport","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/6.mp3"},{"answer":"like baseball, hockey or basketball.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/7.mp3"},{"answer":"Some people do exercises at a gym, or they just go for walks.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/8.mp3"},{"answer":"There are many ways to exercise.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/9.mp3"},{"answer":"They can ride a bicycle or lift weights.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/10.mp3"},{"answer":"There are people who like to collect things.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/11.mp3"},{"answer":"They can collect all kinds of different things.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/12.mp3"},{"answer":"You can collect stamps, coins, dolls,","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/13.mp3"},{"answer":"postcards, movies, rocks or posters.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/14.mp3"},{"answer":"Some people even collect bugs or leaves.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/15.mp3"},{"answer":"Some people are lucky enough to be able to travel.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/16.mp3"},{"answer":"You can travel to a nearby place","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/17.mp3"},{"answer":"or you can travel far away to a different country.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/18.mp3"},{"answer":"There are people who like to listen to music.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/19.mp3"},{"answer":"People have different tastes in music.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/20.mp3"},{"answer":"Some people like rock music","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/21.mp3"},{"answer":"rap, classical music, or folk music.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/22.mp3"},{"answer":"There are many different types of music.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/23.mp3"},{"answer":"Some people would rather play music than listen to it.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/23-2023-05-14-21-51-46.mp3"},{"answer":"You can play an instrument or you can sing.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/24-2023-05-14-21-51-52.mp3"},{"answer":"Many people learn to play the guitar or the piano.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/24.mp3"},{"answer":"Some people join bands or orchestras.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/25.mp3"},{"answer":"There are people who like to read books.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/26.mp3"},{"answer":"There are a lot of different hobbies.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/27.mp3"},{"answer":"It depends on what you consider to be fun.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/28.mp3"},{"answer":"You can have more than one hobby or interest.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/31-2023-07-30-12-31-47.mp3"},{"answer":"It is good to be interested in a lot of different things.","audio":"https://dailydictation.com/upload/general-english/29-interests-and-hobbies-2019-03-20-09-22-32/30.mp3"}]
