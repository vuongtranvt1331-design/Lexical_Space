[{"answer":"Would you like anything else? You haven't eaten very much.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/1.mp3"},{"answer":"No, thanks. I'm already full.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/2.mp3"},{"answer":"Oh, come on. Have some more.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/3.mp3"},{"answer":"No, I really can't. I've never been much of an eater.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/4.mp3"},{"answer":"Have some coffee then.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/5.mp3"},{"answer":"That would be nice.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/6.mp3"},{"answer":"How do you take it?","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/7.mp3"},{"answer":"With sugar please, no cream.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/8.mp3"},{"answer":"Here you are.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/9.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/english-conversations/58-a-light-eater-2022-03-07-21-24-02/10.mp3"}]
