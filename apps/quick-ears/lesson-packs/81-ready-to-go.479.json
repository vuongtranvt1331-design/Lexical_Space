[{"answer":"Are you ready?","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/1.mp3"},{"answer":"Grace is still in her room.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/2.mp3"},{"answer":"She needs to rush. We don't have enough time.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/3.mp3"},{"answer":"What time does the movie begin?","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/4.mp3"},{"answer":"It starts at 7:30.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/5.mp3"},{"answer":"What's the time now?","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/6.mp3"},{"answer":"About 7:10.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/7.mp3"},{"answer":"There's no hurry. It only takes ten minutes by car to get there.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/8.mp3"},{"answer":"I know, but there aren't enough parking spaces around the theatre.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/9.mp3"},{"answer":"Well, I'd better tell Grace to hurry up.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/10.mp3"},{"answer":"She can take hours to get ready.","audio":"https://dailydictation.com/upload/english-conversations/81-ready-to-go-2022-03-07-21-31-04/11.mp3"}]
