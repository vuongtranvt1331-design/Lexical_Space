[{"answer":"A house is divided into different rooms.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/1.mp3"},{"answer":"In my house, there is a living room.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/2.mp3"},{"answer":"There is a couch, two chairs, a coffee table and a television set in the living room.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/3.mp3"},{"answer":"In the kitchen, there is a stove and a refrigerator.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/4.mp3"},{"answer":"There is also a sink and a dishwasher in the kitchen.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/5.mp3"},{"answer":"There is a kitchen table and chairs.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/6.mp3"},{"answer":"We eat most of our meals at the kitchen table.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/7.mp3"},{"answer":"We have a dining room.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/8.mp3"},{"answer":"There is a dining table and chairs in there.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/9.mp3"},{"answer":"There is a washroom or bathroom.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/10.mp3"},{"answer":"There is a toilet, sink and bathtub in the bathroom.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/11.mp3"},{"answer":"There is also a shower in the bathroom.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/12.mp3"},{"answer":"We have three bedrooms.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/13.mp3"},{"answer":"The bedrooms are upstairs.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/14.mp3"},{"answer":"My brother's room, my room and my parents' room all have beds in them.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/15.mp3"},{"answer":"We also have dressers in our rooms.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/16.mp3"},{"answer":"There are closets in all of the bedrooms.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/17.mp3"},{"answer":"We keep our clothes in the closets.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/18.mp3"},{"answer":"There is a basement in our house.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/19.mp3"},{"answer":"We store things in the basement.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/20.mp3"},{"answer":"There is a laundry room in the basement.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/21.mp3"},{"answer":"There is a washing machine and a dryer in the laundry room.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/22.mp3"},{"answer":"This is where we wash and dry our clothes.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/23.mp3"},{"answer":"There is a garage attached to the house.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/24.mp3"},{"answer":"We keep the car in the garage.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/25.mp3"},{"answer":"You drive up the driveway and into the garage.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/26.mp3"},{"answer":"We also have a front yard and a backyard.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/27.mp3"},{"answer":"There is a vegetable garden in the backyard.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/28.mp3"},{"answer":"There are some flowers and a tree planted in the front yard.","audio":"https://dailydictation.com/upload/general-english/25-house-2019-03-20-08-57-17/29.mp3"}]
