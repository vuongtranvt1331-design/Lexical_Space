[{"answer":"My grandfather fought in World War II.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/1.mp3"},{"answer":"My grandmother was a nurse in World War II.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/2.mp3"},{"answer":"Today is November 11th.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/3.mp3"},{"answer":"Today is Remembrance Day.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/4.mp3"},{"answer":"Today we celebrate soldiers.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/5.mp3"},{"answer":"Everyone wears a poppy.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/6.mp3"},{"answer":"Poppies are red flowers.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/7.mp3"},{"answer":"Poppies remind me of my grandparents.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/8.mp3"},{"answer":"Poppies remind me of their sacrifice.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/9.mp3"},{"answer":"At 11 A.M, there are two minutes of silence.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/10.mp3"},{"answer":"People remember their friends and family.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/11.mp3"},{"answer":"People recite the poem \"In Flanders Field\".","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/12.mp3"},{"answer":"It is a sad poem.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/13.mp3"},{"answer":"It helps us remember.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/14.mp3"},{"answer":"Today we wish for peace in the world.","audio":"https://dailydictation.com/upload/general-english/14-remembrance-day-2019-03-20-04-52-03/15.mp3"}]
