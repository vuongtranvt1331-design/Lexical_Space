[{"answer":"What time is it?","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/1.mp3"},{"answer":"It's three o'clock.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/2.mp3"},{"answer":"Oh no, I'm late.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/3.mp3"},{"answer":"Where are you going?","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/4-2025-05-14-16-17-24.mp3"},{"answer":"To the dentist.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/5.mp3"},{"answer":"Can I drive you there?","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/6.mp3"},{"answer":"Sure! That will help.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/7.mp3"},{"answer":"Do you have a toothache?","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/8.mp3"},{"answer":"Yes, and it's very bad.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/9.mp3"},{"answer":"I'm sorry to hear that.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/10.mp3"},{"answer":"I've had it for weeks, and this is the first time that I could get in.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/11.mp3"},{"answer":"My dentist is always so busy!","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/12.mp3"},{"answer":"I guess that's a good thing! It means a lot of people like him.","audio":"https://dailydictation.com/upload/english-conversations/35-can-i-drive-there-2022-03-07-21-16-17/13.mp3"}]
