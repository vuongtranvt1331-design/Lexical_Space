[{"answer":"I have been having trouble seeing the blackboard.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/1.mp3"},{"answer":"Everything is blurry.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/2.mp3"},{"answer":"I keep getting headaches.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/3.mp3"},{"answer":"I told my mother about it,","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/4.mp3"},{"answer":"and she made an appointment with the optometrist.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/5.mp3"},{"answer":"I went to a place where they made me read words and letters on a chart.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/6.mp3"},{"answer":"Some of the words were big,","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/7.mp3"},{"answer":"and some were very small.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/8.mp3"},{"answer":"I tried to read everything,","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/9.mp3"},{"answer":"but sometimes I couldn't see some of the small letters.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/10.mp3"},{"answer":"The optometrist would cover one of my eyes while I read the chart.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/11.mp3"},{"answer":"Then, she would cover my other eye.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/12.mp3"},{"answer":"She even put some drops in my eyes.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/13.mp3"},{"answer":"I asked the optometrist if I had passed or failed the test.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/14.mp3"},{"answer":"She laughed, and said it wasn't that kind of test that you passed or failed.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/15.mp3"},{"answer":"She was just trying to find out if I needed glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/16.mp3"},{"answer":"I did need glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/17.mp3"},{"answer":"My mother and I looked around.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/18.mp3"},{"answer":"There were many pairs of frames.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/19.mp3"},{"answer":"I wanted something that was in style.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/20.mp3"},{"answer":"I tried on many pairs of frames.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/21.mp3"},{"answer":"Some of them looked good on me, and some of them looked really funny on me.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/22.mp3"},{"answer":"I finally chose a frame that was my favorite.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/23.mp3"},{"answer":"I gave them to a lady who did some measurements.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/24.mp3"},{"answer":"She told me to come back on Friday to get my glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/25.mp3"},{"answer":"On Friday, I got my glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/26.mp3"},{"answer":"My friends liked them.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/27.mp3"},{"answer":"They said I looked smart in my glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/28.mp3"},{"answer":"I wore them to school on Monday,","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/29.mp3"},{"answer":"and I was able to see the blackboard clearly.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/30.mp3"},{"answer":"I didn't realize how much I hadn't been able to see.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/31.mp3"},{"answer":"Now I don't get headaches anymore.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/32.mp3"},{"answer":"I'm glad that I have my glasses.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/33.mp3"},{"answer":"Everything is a lot clearer now.","audio":"https://dailydictation.com/upload/general-english/126-i-need-glasses-2019-04-07-04-21-25/34.mp3"}]
