[{"answer":"I hate to get up in the morning.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/1.mp3"},{"answer":"Me too! What time do you get up?","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/2.mp3"},{"answer":"At six o'clock.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/3.mp3"},{"answer":"Why do you get up so early?","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/4.mp3"},{"answer":"I have to be at work by seven.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/5.mp3"},{"answer":"I don't get up until eight.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/6.mp3"},{"answer":"You're lucky. What do you do?","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/7.mp3"},{"answer":"I own a bookstore.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/8.mp3"},{"answer":"What time does your store open?","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/9.mp3"},{"answer":"At 8:30.","audio":"https://dailydictation.com/upload/english-conversations/17-i-hate-to-get-up-2022-03-07-21-09-43/10.mp3"}]
