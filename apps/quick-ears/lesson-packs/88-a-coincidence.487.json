[{"answer":"Teresa! What a surprise! What are you doing here?","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/1.mp3"},{"answer":"Timothy! I don't believe it!","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/2.mp3"},{"answer":"I'm going to see my daughter. She will marry this weekend. How about you?","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/3.mp3"},{"answer":"I'm going to visit my parents.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/4.mp3"},{"answer":"When is your daughter's wedding?","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/5.mp3"},{"answer":"Sunday.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/6.mp3"},{"answer":"Wow! This Sunday is the 45th wedding anniversary of their wedding, too.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/7.mp3"},{"answer":"This is a surprise!","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/8.mp3"},{"answer":"Anyway, where is your train leaving from?","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/9.mp3"},{"answer":"My train leaves from Platform 3, over there.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/10.mp3"},{"answer":"How long will you...","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/11.mp3"},{"answer":"Now leaving from Platform 3, train for Vancouver.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/12.mp3"},{"answer":"That's my train. I have to run. Sorry we didn't get more time to talk.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/13.mp3"},{"answer":"That's OK. I'll see you when you get back.","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/14.mp3"},{"answer":"Have a good time, and say congratulations to your parents!","audio":"https://dailydictation.com/upload/english-conversations/88-a-coincidence-2022-03-07-21-34-43/15.mp3"}]
