[{"answer":"I'm going to play soccer.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/1.mp3"},{"answer":"Who are you playing with?","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/2.mp3"},{"answer":"Some friends from work.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/3.mp3"},{"answer":"Are you a good soccer player?","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/4.mp3"},{"answer":"Yes, but I'm not the best player on the team.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/5.mp3"},{"answer":"What time does the game begin?","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/6.mp3"},{"answer":"Nine o'clock.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/7.mp3"},{"answer":"Why don't you come with me?","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/8.mp3"},{"answer":"I can't today. I'm very busy.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/9.mp3"},{"answer":"Okay. See you later.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/10.mp3"},{"answer":"I hope your team wins.","audio":"https://dailydictation.com/upload/english-conversations/53-a-soccer-game-2022-03-07-21-22-30/11.mp3"}]
