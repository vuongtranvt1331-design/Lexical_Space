[{"answer":"Hello... Motor Insurance Department...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/1.mp3"},{"answer":"Oh hello...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/2.mp3"},{"answer":"I'd like to ask about insurance for my car.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/3.mp3"},{"answer":"Yes, of course.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/4.mp3"},{"answer":"I'll just take a few details.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/5.mp3"},{"answer":"What's your name?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/6.mp3"},{"answer":"Patrick Jones.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/7.mp3"},{"answer":"And your address?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/8.mp3"},{"answer":"It's 27 Bank Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/9.mp3"},{"answer":"27 Bank Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/10.mp3"},{"answer":"Is that in Greendale?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/11.mp3"},{"answer":"Yes.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/12.mp3"},{"answer":"And what's your daytime phone number?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/13.mp3"},{"answer":"My work number is 730453.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/14.mp3"},{"answer":"And could I ask what your occupation is?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/15.mp3"},{"answer":"Dentist.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/16.mp3"},{"answer":"Okay...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/17.mp3"},{"answer":"Now, a few details about your car...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/18.mp3"},{"answer":"What size is the engine?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/19.mp3"},{"answer":"It's 1200 ccs.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/20.mp3"},{"answer":"Thank you...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/21.mp3"},{"answer":"and the make and model?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/22.mp3"},{"answer":"It's a Hewton Sable.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/23.mp3"},{"answer":"Could you spell the model name please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/24.mp3"},{"answer":"Yes... SABLE.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/25.mp3"},{"answer":"Ah yes... thanks.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/26.mp3"},{"answer":"And when was it made?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/27.mp3"},{"answer":"1997.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/28.mp3"},{"answer":"Lovely...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/29.mp3"},{"answer":"right...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/30.mp3"},{"answer":"I presume you've had a previous insurer?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/31.mp3"},{"answer":"Yes.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/32.mp3"},{"answer":"Right...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/33.mp3"},{"answer":"we need to know the name of the company.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/34.mp3"},{"answer":"Yes... it was Northern Star.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/35.mp3"},{"answer":"Thank you,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/36.mp3"},{"answer":"and have you made any insurance claims in the last five years?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/37.mp3"},{"answer":"Yes...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/38.mp3"},{"answer":"one in 1999.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/39.mp3"},{"answer":"And what was the problem?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/40.mp3"},{"answer":"It was stolen... but...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/41.mp3"},{"answer":"That's fine, Mr Jones... that's all we need to know at the moment...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/42.mp3"},{"answer":"And will there be any other named drivers?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/43.mp3"},{"answer":"Just the one...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/44.mp3"},{"answer":"And his name?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/45.mp3"},{"answer":"Simon Paynter.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/46.mp3"},{"answer":"Could you spell the surname please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/47.mp3"},{"answer":"PAYNTER.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/48.mp3"},{"answer":"Okay, thank you...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/49.mp3"},{"answer":"And what relationship is he to you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/50.mp3"},{"answer":"He's my brother-in-law.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/51.mp3"},{"answer":"And what will you or Mr Paynter be using the car for?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/52.mp3"},{"answer":"Well... uh... mainly for social use...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/53.mp3"},{"answer":"Will you be using it to travel to work?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/54.mp3"},{"answer":"Yes... sometimes.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/55.mp3"},{"answer":"Anything else?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/56.mp3"},{"answer":"No. That's it.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/57.mp3"},{"answer":"And finally, when would you like to start the insurance?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/58.mp3"},{"answer":"I'll need it from the 31st of January.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/59.mp3"},{"answer":"Right...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/60.mp3"},{"answer":"Mr Jones... I'm getting a couple of quotes coming up on the computer now...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/61.mp3"},{"answer":"and the best bet looks like being with a company called Red Flag.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/62.mp3"},{"answer":"Yeah.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/63.mp3"},{"answer":"And that comes out at $450 per year...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/64.mp3"},{"answer":"That seems okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/65.mp3"},{"answer":"It's quite a bit lower than I've been paying up to now.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/66.mp3"},{"answer":"Great.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/67.mp3"},{"answer":"So, would you like me to go ahead with that?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/68.mp3"},{"answer":"Sure... why not?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/69.mp3"},{"answer":"How would you like to pay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-2-part-1-2023-07-28-17-12-17/70.mp3"}]
