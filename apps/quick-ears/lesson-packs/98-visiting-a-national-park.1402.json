[{"answer":"Did you visit Redwood National Park over the weekend?","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/1.mp3"},{"answer":"Yes. It was incredible!","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/2.mp3"},{"answer":"The trees are so tall and majestic.","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/3.mp3"},{"answer":"Oh, I bet!","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/4.mp3"},{"answer":"Did you take the guided tour or explore on your own?","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/5.mp3"},{"answer":"We decided to explore on our own.","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/6.mp3"},{"answer":"The map we got at the visitor center was really helpful.","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/7.mp3"},{"answer":"Were there many people there?","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/8.mp3"},{"answer":"Not too many.","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/9.mp3"},{"answer":"We went early in the morning, so it was pretty peaceful.","audio":"https://dailydictation.com/upload/toeic/conversation-visiting-a-national-park-2024-07-21-17-34-53/10.mp3"}]
