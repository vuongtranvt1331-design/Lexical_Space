[{"answer":"What kind of work do you do?","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/1.mp3"},{"answer":"I'm a cashier at a supermarket.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/2.mp3"},{"answer":"Do you like your job?","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/3.mp3"},{"answer":"No, It's not very interesting.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/4.mp3"},{"answer":"And you don't make much money.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/5.mp3"},{"answer":"That's right. I make very little.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/6.mp3"},{"answer":"I think you should look for another job.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/7.mp3"},{"answer":"I am, but it's not easy to find one.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/8.mp3"},{"answer":"Keep looking! You'll get one.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/9.mp3"},{"answer":"Thanks. I hope you're right.","audio":"https://dailydictation.com/upload/english-conversations/75-a-cashier-2022-03-07-21-29-12/10.mp3"}]
