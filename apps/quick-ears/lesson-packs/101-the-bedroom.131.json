[{"answer":"My bed is nice and soft.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/1.mp3"},{"answer":"I have a pretty bedspread on my bed.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/2.mp3"},{"answer":"I have sheets and a blanket on my bed also.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/3.mp3"},{"answer":"I use two feather pillows.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/4.mp3"},{"answer":"My pillows have pillowcases on them.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/5.mp3"},{"answer":"My dresser has a mirror on it.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/6.mp3"},{"answer":"I have a lamp on top of my dresser.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/7.mp3"},{"answer":"I also have some picture frames with pictures of my friends and family on top of my dresser.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/8.mp3"},{"answer":"There is an alarm clock beside my bed so that I can wake up on time in the morning.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/9.mp3"},{"answer":"I keep many clothes in my dresser drawers.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/10.mp3"},{"answer":"The drawers are nice and deep.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/11.mp3"},{"answer":"My closet is large.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/12.mp3"},{"answer":"It is a walk-in closet.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/13.mp3"},{"answer":"I have my clothes hanging in my closet.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/14.mp3"},{"answer":"All of the clothes are hung on hangers.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/15.mp3"},{"answer":"My shoes are all lined up on the floor of my closet.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/16.mp3"},{"answer":"There are shelves at the top of my closet.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/17.mp3"},{"answer":"I keep games up there.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/18.mp3"},{"answer":"There is a rug on my bedroom floor.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/19.mp3"},{"answer":"My bedroom window looks out over the backyard.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/20.mp3"},{"answer":"There are curtains on my bedroom window.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/21.mp3"},{"answer":"My bedroom is very cozy.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/22.mp3"},{"answer":"At night, I turn off the lamp and get under the covers.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/23.mp3"},{"answer":"I set my alarm clock for seven o'clock.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/24.mp3"},{"answer":"I lay my head on the pillow, and I fall asleep.","audio":"https://dailydictation.com/upload/general-english/101-the-bedroom-2019-04-07-03-54-22/25.mp3"}]
