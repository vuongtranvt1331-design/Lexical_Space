[{"answer":"My very favorite color is purple.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/1.mp3"},{"answer":"There are not a lot of things that are purple.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/2.mp3"},{"answer":"Some grapes are purple.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/3.mp3"},{"answer":"Sometimes the sky looks purple.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/4.mp3"},{"answer":"My second favorite color is blue.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/5.mp3"},{"answer":"Some things are blue.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/6.mp3"},{"answer":"The sky is blue, and water is blue.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/7.mp3"},{"answer":"Many people have blue eyes.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/8.mp3"},{"answer":"Green is a very common color in nature.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/9.mp3"},{"answer":"Trees are green in the summer.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/10.mp3"},{"answer":"Some trees are green all year long.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/11.mp3"},{"answer":"Grass is green.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/12.mp3"},{"answer":"Sometimes water looks green.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/13.mp3"},{"answer":"Many people have green eyes.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/14.mp3"},{"answer":"Many vegetables are green.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/15.mp3"},{"answer":"Broccoli, cabbage, beans, lettuce, peas,","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/16.mp3"},{"answer":"and cucumbers are all green.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/17.mp3"},{"answer":"Green vegetables are very good for you.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/18.mp3"},{"answer":"Yellow is a bright color.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/19.mp3"},{"answer":"The sun looks yellow.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/20.mp3"},{"answer":"Bananas are yellow.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/21.mp3"},{"answer":"Some people have yellow hair.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/22.mp3"},{"answer":"Daffodils and dandelions are yellow.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/23.mp3"},{"answer":"White is a common color, especially in the winter.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/24.mp3"},{"answer":"Snow is white.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/25.mp3"},{"answer":"Clouds are white.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/26.mp3"},{"answer":"Polar bears, some dogs and some cats are white.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/27.mp3"},{"answer":"There are white flowers that grow.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/28.mp3"},{"answer":"Some flowers are red.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/29.mp3"},{"answer":"Roses can be red.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/30.mp3"},{"answer":"Blood is red.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/31.mp3"},{"answer":"Sometimes the sky is red at night or in the morning.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/32.mp3"},{"answer":"Artists use all these colors to make beautiful paintings.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/33.mp3"},{"answer":"Nature used all these colors to make the beautiful earth.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/34.mp3"},{"answer":"We are fortunate to be surrounded by beauty.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/35.mp3"},{"answer":"We should do our part to make sure that nature stays beautiful and clean.","audio":"https://dailydictation.com/upload/general-english/94-favorite-colors-2019-04-07-03-51-10/36.mp3"}]
