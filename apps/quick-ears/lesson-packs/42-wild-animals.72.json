[{"answer":"Some animals are wild.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/1.mp3"},{"answer":"They don't live in homes or cages.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/2.mp3"},{"answer":"They live in jungles or on plains.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/3.mp3"},{"answer":"The lion is the king of the beasts.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/4.mp3"},{"answer":"He is very mighty. He roars loudly.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/5.mp3"},{"answer":"The giraffe has a long neck.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/6.mp3"},{"answer":"He eats leaves from the tallest trees.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/7.mp3"},{"answer":"The elephant is very large.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/8.mp3"},{"answer":"He has a trunk and two tusks.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/9.mp3"},{"answer":"A tiger has stripes.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/10.mp3"},{"answer":"Some bears are black, and some are brown.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/11.mp3"},{"answer":"There are even white bears called polar bears.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/12.mp3"},{"answer":"A kangaroo lives in Australia.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/13.mp3"},{"answer":"That is the only place that you would find a kangaroo, except in a zoo.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/14.mp3"},{"answer":"It might be frightening to run into a wolf or a fox.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/15.mp3"},{"answer":"Monkeys run and play in the trees.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/16.mp3"},{"answer":"In Canada, we don't see lions, tigers, giraffes or monkeys running wild.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/17.mp3"},{"answer":"There are squirrels in my backyard.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/18.mp3"},{"answer":"Sometimes, I see a raccoon or a chipmunk.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/19.mp3"},{"answer":"In northern Ontario, you might see a moose or a bear.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/20.mp3"},{"answer":"I have seen a deer in the forest.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/21.mp3"},{"answer":"There are many wild animals.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/22.mp3"},{"answer":"You can see wild animals if you go to the zoo.","audio":"https://dailydictation.com/upload/general-english/42-wild-animals-2019-03-29-10-15-56/23.mp3"}]
