[{"answer":"My son is graduating from high school today!","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/1.mp3"},{"answer":"And my daughter is graduating next year.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/2.mp3"},{"answer":"How old is she?","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/3.mp3"},{"answer":"She's sixteen.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/4.mp3"},{"answer":"I remember when she was a baby.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/5.mp3"},{"answer":"I know. We're getting old.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/6.mp3"},{"answer":"Don't say that!","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/7.mp3"},{"answer":"Why not? It's true.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/8.mp3"},{"answer":"No, it isn't. We were young when we got married.","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/9.mp3"},{"answer":"That's right, but we got married 25 years ago!","audio":"https://dailydictation.com/upload/english-conversations/54-not-so-young-2022-03-07-21-22-46/10.mp3"}]
