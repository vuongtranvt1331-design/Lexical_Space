[{"answer":"On the top of my head, I have hair.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/1.mp3"},{"answer":"Below my hair is my face.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/2.mp3"},{"answer":"I have two eyes.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/3.mp3"},{"answer":"I have eyebrows and eyelashes.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/4.mp3"},{"answer":"Below my eyes, I have a nose.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/5.mp3"},{"answer":"My mouth is below my nose.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/6.mp3"},{"answer":"I have lips.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/7.mp3"},{"answer":"If I open my lips, you will see my teeth and my tongue.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/8.mp3"},{"answer":"Below my mouth is my chin.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/9.mp3"},{"answer":"On the sides of my head, I have two ears.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/10.mp3"},{"answer":"My cheeks are on either side of my nose.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/11.mp3"},{"answer":"My neck holds up my head.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/12.mp3"},{"answer":"My neck attaches my head to my chest.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/13.mp3"},{"answer":"On either side of my chest are my shoulders.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/14.mp3"},{"answer":"My arms hang down from my shoulders.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/15.mp3"},{"answer":"I have wrists on my arms.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/16.mp3"},{"answer":"My hands are attached to my wrists.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/17.mp3"},{"answer":"My fingers are part of my hands.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/18.mp3"},{"answer":"I have ten fingers and ten fingernails.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/19.mp3"},{"answer":"My back is at the back of me.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/20.mp3"},{"answer":"Further down, there is my waist.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/21.mp3"},{"answer":"If I wear a belt, I put it on my waist.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/22.mp3"},{"answer":"My hips are below my waist.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/23.mp3"},{"answer":"My legs come down from my hips.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/24.mp3"},{"answer":"My legs are made up of my thighs, my knees and my calves.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/25.mp3"},{"answer":"My knees can bend.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/26.mp3"},{"answer":"My ankles are below my legs.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/27.mp3"},{"answer":"My feet are attached to my ankles.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/28.mp3"},{"answer":"My toes are part of my feet.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/29.mp3"},{"answer":"I have ten toes and ten toenails.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/30.mp3"},{"answer":"I am me from the top of my head to the tip of my toes.","audio":"https://dailydictation.com/upload/general-english/39-my-body-2019-03-20-09-46-10/31.mp3"}]
