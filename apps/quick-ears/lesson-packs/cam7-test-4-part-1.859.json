[{"answer":"Yes, what can I do for you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/1.mp3"},{"answer":"My friend is in homestay...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/2.mp3"},{"answer":"and she really enjoys it...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/3.mp3"},{"answer":"so I'd like to join a family as well.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/4.mp3"},{"answer":"Okay, so let me get some details.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/5.mp3"},{"answer":"What's your name?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/6.mp3"},{"answer":"My name is Keiko Yuichini.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/7.mp3"},{"answer":"Could you spell your family name for me?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/8.mp3"},{"answer":"It's... Yuichini,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/9.mp3"},{"answer":"that's YUICHINI.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/10.mp3"},{"answer":"And your first name?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/11.mp3"},{"answer":"It's Keiko.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/12.mp3"},{"answer":"KEIKO.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/13.mp3"},{"answer":"That's Keiko Yuichini... okay...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/14.mp3"},{"answer":"and you're female.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/15.mp3"},{"answer":"And your nationality?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/16.mp3"},{"answer":"I'm Japanese.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/17.mp3"},{"answer":"Right and could I see your passport, please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/18.mp3"},{"answer":"Here it is...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/19.mp3"},{"answer":"Okay... your passport number is JO 6337...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/20.mp3"},{"answer":"And you're how old?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/21.mp3"},{"answer":"I'm 28 years old.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/22.mp3"},{"answer":"Now, you live at one of the colleges... which one?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/23.mp3"},{"answer":"Willow College, umm...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/24.mp3"},{"answer":"Room 21C.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/25.mp3"},{"answer":"Right, 21C Willow College,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/26.mp3"},{"answer":"and how long are you planning on staying with homestay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/27.mp3"},{"answer":"About four months...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/28.mp3"},{"answer":"longer if I like it...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/29.mp3"},{"answer":"And what course are you enrolled in?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/30.mp3"},{"answer":"Well, I've enrolled for twenty weeks in the...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/31.mp3"},{"answer":"um... Advanced English Studies","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/32.mp3"},{"answer":"because I need help with my writing,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/33.mp3"},{"answer":"and I'm nearly at the end of my first five-week course.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/34.mp3"},{"answer":"Okay... Do you have any preference for a family with children or without children?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/35.mp3"},{"answer":"I prefer... I mean, I like young children,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/36.mp3"},{"answer":"but I'd like to be with older people...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/37.mp3"},{"answer":"you know... adults... someone around my age.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/38.mp3"},{"answer":"Okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/39.mp3"},{"answer":"And what about pets?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/40.mp3"},{"answer":"I am a veterinarian so that's fine... the more the better.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/41.mp3"},{"answer":"All right, now what about you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/42.mp3"},{"answer":"Are you a vegetarian or do you have any special food requirements?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/43.mp3"},{"answer":"No, I am not a vegetarian...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/44.mp3"},{"answer":"but I don't eat a lot of meat...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/45.mp3"},{"answer":"I really like seafood.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/46.mp3"},{"answer":"And what are your hobbies?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/47.mp3"},{"answer":"I like reading and going to the movies.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/48.mp3"},{"answer":"Do you play any sports?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/49.mp3"},{"answer":"Yes, I joined the handball team,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/50.mp3"},{"answer":"but I didn't like that... so I stopped playing.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/51.mp3"},{"answer":"Now I play tennis on the weekend with my friends...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/52.mp3"},{"answer":"Alright,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/53.mp3"},{"answer":"let's see, name, age, now the location.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/54.mp3"},{"answer":"Are you familiar with the public transport system?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/55.mp3"},{"answer":"No, I'm not really because I have been living on campus,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/56.mp3"},{"answer":"I've been to the city a few times on the bus, but they are always late.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/57.mp3"},{"answer":"What about the trains?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/58.mp3"},{"answer":"I like catching the train, they are much faster.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/59.mp3"},{"answer":"Now, let me go check on the computer and see who I've got...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/60.mp3"},{"answer":"Listen, leave it with me... I'll check my records and I'll give you details this afternoon.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/61.mp3"},{"answer":"Thank you for helping me!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/62.mp3"},{"answer":"It's a pleasure.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/63.mp3"},{"answer":"Bye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/64.mp3"},{"answer":"Bye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-7-test-4-part-1-2023-07-31-19-31-20/65.mp3"}]
