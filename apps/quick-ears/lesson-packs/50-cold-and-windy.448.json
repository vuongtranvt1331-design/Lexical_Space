[{"answer":"Is it cold out?","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/1.mp3"},{"answer":"Yes, it's cold and windy!","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/2.mp3"},{"answer":"I'm going to wear my heavy coat.","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/3.mp3"},{"answer":"Good idea! Where are you going?","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/4.mp3"},{"answer":"To the post office.","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/5.mp3"},{"answer":"Why?","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/6.mp3"},{"answer":"To mail this package.","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/7.mp3"},{"answer":"Would you buy some stamps for me?","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/8.mp3"},{"answer":"Sure. How many do you want?","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/9.mp3"},{"answer":"Ten.","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/10.mp3"},{"answer":"Here's the money for the stamps.","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/11.mp3"},{"answer":"Okay. I'll be back in twenty minutes, unless I get blown away!","audio":"https://dailydictation.com/upload/english-conversations/50-cold-and-windy-2022-03-07-21-21-28/12.mp3"}]
