[{"answer":"I just got a job at the grocery store.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/1.mp3"},{"answer":"This is my first job.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/2.mp3"},{"answer":"I will receive a pay cheque every two weeks.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/3.mp3"},{"answer":"I wear a uniform.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/4.mp3"},{"answer":"The uniform has the name of the grocery store on it.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/5.mp3"},{"answer":"I have many jobs at the grocery store.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/6.mp3"},{"answer":"I have to collect all the carts from the parking lot","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/7.mp3"},{"answer":"and bring them back into the store.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/8.mp3"},{"answer":"I have to put all the produce out for the people to see.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/9.mp3"},{"answer":"I will be putting out the vegetables.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/10.mp3"},{"answer":"There are carrots, lettuce, cabbages, cucumbers and beans to put out this morning.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/11.mp3"},{"answer":"I also have to put the fruit out on the stands so that it looks nice.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/12.mp3"},{"answer":"The oranges roll away when I put them out, so I have to be careful.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/13.mp3"},{"answer":"I put out the apples, bananas and grapes.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/14.mp3"},{"answer":"I stack boxes up so that people can buy cereal and cookies.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/15.mp3"},{"answer":"I have to be careful, or the boxes will fall.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/16.mp3"},{"answer":"There are cans of things which also need to be placed on the shelves.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/17.mp3"},{"answer":"Yesterday, I filled the shelves with canned vegetables and soup.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/18.mp3"},{"answer":"I like talking to people at the grocery store.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/19.mp3"},{"answer":"This morning, a lady asked me where the bakery department was.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/20.mp3"},{"answer":"She needed a loaf of bread.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/21.mp3"},{"answer":"I have directed people to the meat department,","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/22.mp3"},{"answer":"and to the dairy products.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/23.mp3"},{"answer":"I would like to work in the bakery.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/24.mp3"},{"answer":"I think I would like to bake cakes and decorate them.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/25.mp3"},{"answer":"It would be fun to bake breads and cookies.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/26.mp3"},{"answer":"Or maybe, I would like to be a cashier,","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/27.mp3"},{"answer":"and work at the cash register.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/28.mp3"},{"answer":"I am very good at counting money.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/29.mp3"},{"answer":"I am enjoying my job at the grocery store.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/30.mp3"},{"answer":"I hope that I can continue to work here part-time during the school year.","audio":"https://dailydictation.com/upload/general-english/80-my-first-job-2019-03-29-13-03-34/31.mp3"}]
