[{"answer":"Can I get some tickets for plays?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/1.mp3"},{"answer":"Yes. Is there a specific play that you want to see?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/2.mp3"},{"answer":"What plays are on tonight?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/3.mp3"},{"answer":"Cats. But it's sold out.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/4.mp3"},{"answer":"Are there any seats left for tomorrow night?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/5.mp3"},{"answer":"Yes. How many tickets do you want?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/6.mp3"},{"answer":"Two, please.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/7.mp3"},{"answer":"Where would you like to sit?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/8.mp3"},{"answer":"I'm not sure.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/9.mp3"},{"answer":"Well, here's a seating plan of the concert hall.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/10.mp3"},{"answer":"How much is it in the middle section?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/11.mp3"},{"answer":"$50.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/12.mp3"},{"answer":"$50! That's a little too expensive for us.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/13.mp3"},{"answer":"How much is it in the back?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/14.mp3"},{"answer":"$35.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/15.mp3"},{"answer":"That's fine. What time does the play start?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/16.mp3"},{"answer":"At 7 o'clock.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/17.mp3"},{"answer":"What time will the play be over?","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/18.mp3"},{"answer":"At 9:30.","audio":"https://dailydictation.com/upload/english-conversations/80-making-a-reservation-2022-03-07-21-30-39/19.mp3"}]
