[{"answer":"Are you tall or short?","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/1.mp3"},{"answer":"Are you big or small?","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/2.mp3"},{"answer":"People come in many different shapes and sizes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/3.mp3"},{"answer":"Some people wear size small clothes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/4.mp3"},{"answer":"Other people wear size medium clothes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/5.mp3"},{"answer":"There are people who wear large size clothes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/6.mp3"},{"answer":"Some people even wear extra large clothes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/7.mp3"},{"answer":"Some people are thin. Some people are fat.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/8.mp3"},{"answer":"Some people are in between.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/9.mp3"},{"answer":"There are people with short hair.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/10-2019-05-09-09-11-18.mp3"},{"answer":"Other people have long hair.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/11.mp3"},{"answer":"Some people have no hair at all.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/12.mp3"},{"answer":"No two people are exactly alike.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/13.mp3"},{"answer":"Some people have long legs.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/14.mp3"},{"answer":"I have short legs.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/15.mp3"},{"answer":"I don't walk as fast as a person with long legs.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/16.mp3"},{"answer":"I am not a tall person. In fact, I am quite short.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/17.mp3"},{"answer":"My feet are a size seven.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/18.mp3"},{"answer":"My mother has size five feet.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/19.mp3"},{"answer":"My father has size twelve feet.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/20.mp3"},{"answer":"We are all different sizes.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/21.mp3"},{"answer":"It is not a bad thing.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/22.mp3"},{"answer":"It is a good thing that we are all unique.","audio":"https://dailydictation.com/upload/general-english/54-differences-2019-03-29-10-22-58/23.mp3"}]
