[{"answer":"Today is Jessica's first day of kindergarten.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/1.mp3"},{"answer":"Jessica and her parents walk to school.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/2.mp3"},{"answer":"Jessica's mom walks with her to her classroom.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/3.mp3"},{"answer":"Jessica meets her teacher.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/4.mp3"},{"answer":"His name is Mr. Parker.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/5.mp3"},{"answer":"The school bell rings at 8:45 a.m.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/6.mp3"},{"answer":"Jessica hugs and kisses her mom goodbye.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/7.mp3"},{"answer":"Jessica's mom says \"I love you!\".","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/8.mp3"},{"answer":"At 9 a.m, Jessica stands for the national anthem.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/9.mp3"},{"answer":"Mr. Parker calls out children's names.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/10.mp3"},{"answer":"Each child yells back \"here!\".","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/11.mp3"},{"answer":"Mr. Parker teaches them about letters.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/12.mp3"},{"answer":"Mr. Parker teaches them about numbers.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/13.mp3"},{"answer":"At 10:15 a.m, the students have recess.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/14.mp3"},{"answer":"Recess is fun.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/15.mp3"},{"answer":"The students get to play and eat.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/16.mp3"},{"answer":"At 10:30 a.m.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/17.mp3"},{"answer":"the students go to gym class.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/18.mp3"},{"answer":"At 11:15 a.m.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/19.mp3"},{"answer":"the students return to Mr. Parker's classroom.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/20.mp3"},{"answer":"Mr. Parker tells the students to sit on the carpet.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/21.mp3"},{"answer":"Mr. Parker reads the students a story.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/22.mp3"},{"answer":"Mr. Parker teaches the students a song.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/23.mp3"},{"answer":"The lunch bell rings.","audio":"https://dailydictation.com/upload/general-english/2-jessicas-first-day-of-school-2019-03-15-00-20-34/24-2023-10-05-17-02-29.mp3"},{