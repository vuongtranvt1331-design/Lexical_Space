[{"answer":"These are important words.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/1.mp3"},{"answer":"They're all words that begin questions.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/2.mp3"},{"answer":"\"Who\" is about a person.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/3.mp3"},{"answer":"Who is the girl with the blue dress on?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/4.mp3"},{"answer":"Who stole my watch?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/5.mp3"},{"answer":"Who will come with me to the game?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/6.mp3"},{"answer":"Who is driving us to the party?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/7.mp3"},{"answer":"\"What\" is about a thing.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/8.mp3"},{"answer":"What is that big thing on the sidewalk?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/9.mp3"},{"answer":"What should I do when I get to your house?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/10.mp3"},{"answer":"What kind of clothes should I wear to the party?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/11.mp3"},{"answer":"What shall I buy you for your birthday?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/12.mp3"},{"answer":"\"Where\" is about a place.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/13.mp3"},{"answer":"Where are you going for your vacation?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/14.mp3"},{"answer":"Where did I leave my glasses?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/15.mp3"},{"answer":"Where did my brother go?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/16.mp3"},{"answer":"Where on earth is Timmins?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/17.mp3"},{"answer":"\"Why\" is the word that asks for an explanation.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/18.mp3"},{"answer":"Why did you take the last piece of pie?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/19.mp3"},{"answer":"Why is the world round?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/20.mp3"},{"answer":"Why should I give you any money?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/21.mp3"},{"answer":"Why did the chicken cross the street?","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/22.mp3"},{"answer":"They say that you should answer all of these questions if you are writing a good story.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/23.mp3"},{"answer":"You have to give the who, what, where and why to write a good story.","audio":"https://dailydictation.com/upload/general-english/58-who-what-where-and-why-2019-03-29-10-25-41/24.mp3"}]
