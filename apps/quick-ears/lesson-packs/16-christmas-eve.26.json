[{"answer":"Ben and Melissa are getting ready for Christmas.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/1.mp3"},{"answer":"Ben and Melissa's house has lots of lights on the roof.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/2.mp3"},{"answer":"The lights are many colors.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/3.mp3"},{"answer":"Inside they listen to Christmas music.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/4.mp3"},{"answer":"Ben and Melissa drink eggnog.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/5.mp3"},{"answer":"Eggnog tastes good.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/6.mp3"},{"answer":"Ben and Melissa hang stockings on the fireplace.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/7.mp3"},{"answer":"They string popcorn.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/8.mp3"},{"answer":"Ben and Melissa put the popcorn string on the Christmas tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/9.mp3"},{"answer":"They put Christmas lights on the tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/10.mp3"},{"answer":"They put tinsel on the tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/11.mp3"},{"answer":"Ben and Melissa put ornaments on the tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/12.mp3"},{"answer":"They put a star on top of the tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/13.mp3"},{"answer":"They get ready for Santa Claus.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/14.mp3"},{"answer":"They leave milk and cookies for Santa.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/15.mp3"},{"answer":"Ben opens one present.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/16.mp3"},{"answer":"Melissa opens one present.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/17.mp3"},{"answer":"They go to sleep.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/18.mp3"},{"answer":"Ben and Melissa wake up early.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/19.mp3"},{"answer":"They run downstairs.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/20.mp3"},{"answer":"There are a lot of presents under our tree.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/21.mp3"},{"answer":"They wake up their mom and dad.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/22.mp3"},{"answer":"Ben and Melissa open their presents.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/23.mp3"},{"answer":"They love our presents.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/24.mp3"},{"answer":"Everyone cleans up the wrapping paper.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/25.mp3"},{"answer":"It is time for breakfast.","audio":"https://dailydictation.com/upload/general-english/16-christmas-eve-2019-03-20-05-38-46/26.mp3"}]
