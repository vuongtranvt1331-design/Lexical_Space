[{"answer":"Raymond!","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/1.mp3"},{"answer":"Oh, hi, Grace! How have you been?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/2.mp3"},{"answer":"Good! I hear you've been to Toronto for a few days.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/3.mp3"},{"answer":"Yes. I just got back yesterday.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/4.mp3"},{"answer":"Did you have a nice visit?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/5.mp3"},{"answer":"Really nice. It was very good going around downtown and shopping.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/6.mp3"},{"answer":"And I saw the Toronto Blue Jays game at Skydome.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/7.mp3"},{"answer":"It seems that Toronto is a very exciting city.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/8.mp3"},{"answer":"My brother Stanley was there, too.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/9.mp3"},{"answer":"You've met Stanley, haven't you?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/10.mp3"},{"answer":"Sure. I met him when he was here in Hamilton last year.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/11.mp3"},{"answer":"What's he doing these days? Still teaching baseball?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/12.mp3"},{"answer":"Yes, as a matter of fact, he just began to teach elementary school.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/13.mp3"},{"answer":"Great. How's everything with his kids?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/14.mp3"},{"answer":"Have you met my nieces?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/15.mp3"},{"answer":"Yes, they visited you once in the summer, didn't they?","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/16.mp3"},{"answer":"Right. They're both fine.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/17.mp3"},{"answer":"I haven't seen them in a long time. They must be really big.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/18.mp3"},{"answer":"Well, they will come over this Christmas.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/19.mp3"},{"answer":"Let's have a great Christmas party together.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/20.mp3"},{"answer":"That's a good idea.","audio":"https://dailydictation.com/upload/english-conversations/89-how-have-you-been-2022-03-07-21-34-59/21.mp3"}]
