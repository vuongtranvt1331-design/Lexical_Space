[{"answer":"There are many subjects that you can take at school.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/1.mp3"},{"answer":"My favorite subject is music.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/2.mp3"},{"answer":"I like to sing and to play the clarinet.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/3.mp3"},{"answer":"I also like art.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/4.mp3"},{"answer":"I am quite good at drawing and painting.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/5.mp3"},{"answer":"History is a good subject.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/6.mp3"},{"answer":"I like learning about the past.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/7.mp3"},{"answer":"Geography is very interesting.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/8.mp3"},{"answer":"We look at many maps in geography.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/9.mp3"},{"answer":"We learn where there are deserts and mountains.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/10.mp3"},{"answer":"I know the names of all the continents and all the oceans.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/11.mp3"},{"answer":"Mathematics is my least favorite subject.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/12.mp3"},{"answer":"I'm not very good with numbers.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/13.mp3"},{"answer":"I am good at addition and subtraction,","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/14.mp3"},{"answer":"but I'm not good at division and multiplication.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/15.mp3"},{"answer":"In my school, we learn to speak French.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/16.mp3"},{"answer":"We learn French because Canada has French and English-speaking citizens.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/17.mp3"},{"answer":"English literature is a good subject.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/18.mp3"},{"answer":"I enjoy reading books.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/19.mp3"},{"answer":"I also like to write compositions and poetry.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/20.mp3"},{"answer":"Science is my brother's favorite subject.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/21.mp3"},{"answer":"He is interested in plants, and he likes to do experiments.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/22.mp3"},{"answer":"We also take drama at my school. I like to act.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/23.mp3"},{"answer":"I got the lead role in the school play.","audio":"https://dailydictation.com/upload/general-english/27-subjects-2019-03-20-09-10-55/24.mp3"}]
