[{"answer":"It's been raining all week.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/1.mp3"},{"answer":"Any plans for the weekend?","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/2.mp3"},{"answer":"I was hoping to go hiking,","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/3.mp3"},{"answer":"but it doesn't look promising with this weather.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/4.mp3"},{"answer":"How about you?","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/5.mp3"},{"answer":"I had plans to visit the beach, but I might have to cancel, too.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/6.mp3"},{"answer":"Have you checked the forecast?","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/7.mp3"},{"answer":"Any chance it'll clear up?","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/8.mp3"},{"answer":"Not really.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/9.mp3"},{"answer":"Looks like we might need to find some indoor activities instead.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/10.mp3"},{"answer":"Maybe we could just watch some movies or read a book.","audio":"https://dailydictation.com/upload/toeic/conversation-weekend-plans-2024-07-21-17-27-40/11.mp3"}]
