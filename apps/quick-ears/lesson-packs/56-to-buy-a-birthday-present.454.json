[{"answer":"What are you getting Jim for his birthday?","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/1.mp3"},{"answer":"I don't know yet.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/2.mp3"},{"answer":"You can always get him a shirt.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/3.mp3"},{"answer":"But I got him one last year.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/4.mp3"},{"answer":"Oh, that's right. Let me think.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/5.mp3"},{"answer":"I want to get him something different.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/6.mp3"},{"answer":"How about a briefcase?","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/7.mp3"},{"answer":"Good idea! His briefcase is getting old.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/8.mp3"},{"answer":"And it's something he'll use every day.","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/9.mp3"},{"answer":"Of course! Why didn't I think of that?","audio":"https://dailydictation.com/upload/english-conversations/56-to-buy-a-birthday-present-2022-03-07-21-23-22/10.mp3"}]
