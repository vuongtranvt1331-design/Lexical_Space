[{"answer":"My mother says that I am clumsy.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/1.mp3"},{"answer":"My father says that I am clumsy.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/2.mp3"},{"answer":"I know that I am clumsy.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/3.mp3"},{"answer":"I do things all the time that are clumsy.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/4.mp3"},{"answer":"I fall down for no reason at all.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/5.mp3"},{"answer":"If there is a crack in the sidewalk,","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/6.mp3"},{"answer":"I will be sure to trip on it and fall down.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/7.mp3"},{"answer":"If I carry a plate of food in the cafeteria,","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/8.mp3"},{"answer":"I almost always either drop it or bump into someone with it.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/9.mp3"},{"answer":"I don't try to do these things, it just happens.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/10.mp3"},{"answer":"When I drink juice, I miss my mouth and get juice all over my shirt.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/11.mp3"},{"answer":"I always have something spilled on my clothes.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/12.mp3"},{"answer":"Last week I opened a jar of peanut butter.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/13.mp3"},{"answer":"The jar flew out of my hands and landed upside down on the floor.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/14.mp3"},{"answer":"There was a big glob of peanut butter on the floor.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/15.mp3"},{"answer":"Yesterday I knocked over the sugar bowl.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/16.mp3"},{"answer":"There was a big sticky mess on the floor.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/17.mp3"},{"answer":"I bump my head when I get into the car.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/18.mp3"},{"answer":"I rip my pants on things.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/19.mp3"},{"answer":"I lose my money out of my pockets.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/20.mp3"},{"answer":"I step on the cat's tail.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/21.mp3"},{"answer":"I always feel bad when I do that because the cat thinks I don't love her.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/22.mp3"},{"answer":"I don't mean to do these things.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/23.mp3"},{"answer":"I am just a clumsy person.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/24.mp3"},{"answer":"My parents tell me to slow down.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/25.mp3"},{"answer":"I am always in a hurry;","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/26.mp3"},{"answer":"maybe that's why I'm so clumsy.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/27.mp3"},{"answer":"Maybe it's just a stage that I am going through.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/28.mp3"},{"answer":"If it is, I hope it is over soon.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/29.mp3"},{"answer":"Being clumsy is no fun at all.","audio":"https://dailydictation.com/upload/general-english/127-i-am-clumsy-2019-04-07-04-21-39/30.mp3"}]
