[{"answer":"What are you so happy about? You're grinning from ear to ear.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/1.mp3"},{"answer":"Sandy and I are going to go out this weekend.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/2.mp3"},{"answer":"Oh, yeah? That's fast work. That's great!","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/3.mp3"},{"answer":"Which night are you going to see her, Friday or Saturday?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/4.mp3"},{"answer":"On Friday. She isn't going to be in town on Saturday and Sunday.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/5.mp3"},{"answer":"She's going to visit a friend in Quebec.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/6.mp3"},{"answer":"What are you going to do on Friday?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/7.mp3"},{"answer":"I don't know yet. Do you have any ideas?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/8.mp3"},{"answer":"How about taking her to a Chinese restaurant?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/9.mp3"},{"answer":"I've heard that she likes Chinese food.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/10.mp3"},{"answer":"That's a great idea.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/11.mp3"},{"answer":"What are you going to wear on your date?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/12.mp3"},{"answer":"I'm going to wear my new suit.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/13.mp3"},{"answer":"That's too formal. Wear your jeans and a T-shirt.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/14.mp3"},{"answer":"How about your sports jacket?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/15.mp3"},{"answer":"Are you going to wear it on Friday night?","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/16.mp3"},{"answer":"No, I am not. Go ahead and wear it.","audio":"https://dailydictation.com/upload/english-conversations/23-a-date-1-2022-03-07-21-11-51/17.mp3"}]
