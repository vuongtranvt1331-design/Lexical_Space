[{"answer":"Are you free Friday night?","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/1.mp3"},{"answer":"I might not be in town. I'm not sure yet.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/2.mp3"},{"answer":"A friend suggested I go to Vancouver.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/3.mp3"},{"answer":"Well, a few of us are getting together, and I thought you might wanna come, too.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/4.mp3"},{"answer":"What are you thinking of doing?","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/5.mp3"},{"answer":"We're not sure yet.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/6.mp3"},{"answer":"We might go to a bar, but we'll probably go to see A.I.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/7.mp3"},{"answer":"Oh, I haven't seen it yet.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/8.mp3"},{"answer":"Well, come then.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/9.mp3"},{"answer":"Sure, if I'm in town. I'll call you and let you know.","audio":"https://dailydictation.com/upload/english-conversations/63-getting-together-2022-03-07-21-25-51/10.mp3"}]
