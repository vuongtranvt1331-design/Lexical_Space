[{"answer":"When is your vacation?","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/1.mp3"},{"answer":"It starts next week.","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/2.mp3"},{"answer":"Where are you going?","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/3.mp3"},{"answer":"We're renting a house on the shore.","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/4.mp3"},{"answer":"That's wonderful!","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/5.mp3"},{"answer":"Yes, we love the ocean.","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/6.mp3"},{"answer":"Do you swim a lot?","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/7.mp3"},{"answer":"Not very much.","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/8.mp3"},{"answer":"Then, why are you going to the shore?","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/9.mp3"},{"answer":"Because we all bought new swimsuits!","audio":"https://dailydictation.com/upload/english-conversations/52-a-house-at-the-shore-2022-03-07-21-22-13/10.mp3"}]
