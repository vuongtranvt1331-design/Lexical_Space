[{"answer":"This is a nice flat.","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/1.mp3"},{"answer":"Mmm...","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/2.mp3"},{"answer":"There's a living room. There's a kitchen, a bedroom,","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/3.mp3"},{"answer":"and a bathroom and there's a bidet!","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/4.mp3"},{"answer":"What's a bidet?","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/5.mp3"},{"answer":"It's like a toilet, only better,","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/6.mp3"},{"answer":"I'll let you figure it out!","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/7.mp3"},{"answer":"Well, none of my friends have a bidet, and even if I don't know what it is,","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/8.mp3"},{"answer":"they will be very jealous when I tell them!","audio":"https://dailydictation.com/upload/english-conversations/59-a-nice-flat-1-2022-03-07-21-24-20/9.mp3"}]
