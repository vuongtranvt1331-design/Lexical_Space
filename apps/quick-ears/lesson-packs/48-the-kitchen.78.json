[{"answer":"The kitchen is where we make and eat our meals.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/1.mp3"},{"answer":"There is a stove in the kitchen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/2.mp3"},{"answer":"Inside the stove there is an oven where you bake things.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/3.mp3"},{"answer":"You can put a cake into the oven to bake.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/4.mp3"},{"answer":"On top of the stove are burners.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/5.mp3"},{"answer":"The burners get hot.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/6.mp3"},{"answer":"You put pots or pans on the burners.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/7.mp3"},{"answer":"The refrigerator is where we store the food that needs to be kept cold.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/8.mp3"},{"answer":"We keep milk, eggs, cheese and vegetables in the refrigerator.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/9.mp3"},{"answer":"At the top of the refrigerator is the freezer.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/10.mp3"},{"answer":"The freezer keeps things frozen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/11.mp3"},{"answer":"We have frozen vegetables, ice cream and ice cubes in the freezer.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/12.mp3"},{"answer":"We have a toaster in the kitchen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/13.mp3"},{"answer":"You put the bread in the toaster, and it turns into toast.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/14.mp3"},{"answer":"We have an electric kettle.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/15.mp3"},{"answer":"We boil water to make tea in the kettle.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/16.mp3"},{"answer":"There is a double sink in the kitchen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/17.mp3"},{"answer":"That is where we wash the dishes.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/18.mp3"},{"answer":"We turn on the hot tap, and put some dish detergent into the sink to wash the dishes.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/19.mp3"},{"answer":"Sometimes we put the dishes into the dishwasher,","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/20.mp3"},{"answer":"and the dishwasher washes the dishes.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/21.mp3"},{"answer":"There are other things in the kitchen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/22.mp3"},{"answer":"There are utensils like knives, forks and spoons.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/23.mp3"},{"answer":"There are tea towels and dish cloths.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/24.mp3"},{"answer":"There are oven mitts and pot holders to take hot things out of the oven.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/25.mp3"},{"answer":"There are pots to cook and boil things in.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/26.mp3"},{"answer":"There are pans to fry things.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/27.mp3"},{"answer":"We have dishes that we eat from.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/28.mp3"},{"answer":"We have plates for our dinner, and bowls that we can put our soup in.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/29.mp3"},{"answer":"We drink from cups or coffee mugs or glasses","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/30.mp3"},{"answer":"We keep our juice in a pitcher or a jug.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/31.mp3"},{"answer":"There is a timer that you can set when you are cooking.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/32.mp3"},{"answer":"The timer buzzes when the food is ready.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/33.mp3"},{"answer":"We also have a microwave oven in the kitchen.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/34.mp3"},{"answer":"If we are in a hurry, we cook our food in the microwave.","audio":"https://dailydictation.com/upload/general-english/48-the-kitchen-2019-03-29-10-18-57/35.mp3"}]
