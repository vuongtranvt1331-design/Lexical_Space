[{"answer":"Oh, Miss Wallace! Long time no see.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/1.mp3"},{"answer":"How are you?","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/2.mp3"},{"answer":"Good. Thank you. How's your new job?","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/3.mp3"},{"answer":"I started working today.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/4.mp3"},{"answer":"How does it seem so far?","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/5.mp3"},{"answer":"It's demanding, but I'm happy to be working.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/6.mp3"},{"answer":"What's your boss like?","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/7.mp3"},{"answer":"He appears to be very thoughtful and kind,","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/8.mp3"},{"answer":"but they all do at first.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/9.mp3"},{"answer":"I guess we will have to wait and see.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/10.mp3"},{"answer":"Well, I wish you the best of luck.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/11.mp3"},{"answer":"Thanks, take care.","audio":"https://dailydictation.com/upload/english-conversations/64-hows-your-new-job-going-2022-03-07-21-26-14/12.mp3"}]
