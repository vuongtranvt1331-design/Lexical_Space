[{"answer":"Are you going out with Leonard tonight?","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/1.mp3"},{"answer":"Uh huh. He's supposed to pick me up at 6:30 What time is it now?","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/2.mp3"},{"answer":"5:45. You'd better get going.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/3.mp3"},{"answer":"You're kidding. I haven't even taken a shower.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/4.mp3"},{"answer":"Where are you going?","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/5.mp3"},{"answer":"We haven't made up our minds yet. Maybe to a movie, maybe to a party.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/6.mp3"},{"answer":"Go and see Forrest Gump. It's supposed to be interesting.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/7.mp3"},{"answer":"Oh, maybe we will. I've heard The Sixth Sense is good, too.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/8.mp3"},{"answer":"Well, personally I prefer Forrest Gump.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/9.mp3"},{"answer":"I really should be going. Do you wanna go shopping tomorrow?","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/10.mp3"},{"answer":"I'd like to go, but it depends.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/11.mp3"},{"answer":"I might have to go to the store tomorrow and do some work.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/12.mp3"},{"answer":"Can I let you know first thing in the morning?","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/13.mp3"},{"answer":"OK, that would be all right.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/14.mp3"},{"answer":"Oh, there's the phone. It must be Leonard.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/15.mp3"},{"answer":"Well, I'll be going. Call me tomorrow.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/16.mp3"},{"answer":"I will. Have a good evening.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/17.mp3"},{"answer":"You too.","audio":"https://dailydictation.com/upload/english-conversations/43-can-i-let-you-know-2022-03-07-21-19-14/18.mp3"}]
