[{"answer":"How are you settling in?","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/1.mp3"},{"answer":"Oh, we're still in a bit of a mess, but Lisa seems to like it here.","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/2.mp3"},{"answer":"That's good. Is there a garden for her to play in?","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/3.mp3"},{"answer":"Yes, it's not very big, but we've got a small swimming pool.","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/4.mp3"},{"answer":"Have you found a school for Jerry?","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/5.mp3"},{"answer":"Yes, there's one near here. It only takes 5 minutes by car.","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/6.mp3"},{"answer":"That's good. So you like it there, do you, Neal?","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/7.mp3"},{"answer":"Yes, this is a very good place for my children.","audio":"https://dailydictation.com/upload/english-conversations/76-settling-down-2022-03-07-21-29-30/8.mp3"}]
