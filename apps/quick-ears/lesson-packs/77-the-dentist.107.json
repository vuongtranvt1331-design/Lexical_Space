[{"answer":"My friend's father is a dentist.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/1.mp3"},{"answer":"He has an office near my house.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/2.mp3"},{"answer":"I went to see him on Thursday.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/3.mp3"},{"answer":"His nurse told me to sit in a very big chair.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/4.mp3"},{"answer":"She tied a bib under my chin.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/5.mp3"},{"answer":"The dentist came in.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/6.mp3"},{"answer":"He examined my teeth with some shiny silver tools.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/7.mp3"},{"answer":"He looked at my front teeth and my back teeth.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/8.mp3"},{"answer":"He told me that the back teeth were called molars.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/9.mp3"},{"answer":"He told me to \"open wide\".","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/10.mp3"},{"answer":"He had a little mirror that he used to look at my teeth.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/11.mp3"},{"answer":"He said that I had good strong teeth.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/12.mp3"},{"answer":"He told me that I didn't have any cavities.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/13.mp3"},{"answer":"I told him that I didn't eat a lot of candies","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/14.mp3"},{"answer":"and that I always brushed my teeth after every meal.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/15.mp3"},{"answer":"He said that was very good.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/16.mp3"},{"answer":"He asked me if I flossed my teeth, and I said,","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/17.mp3"},{"answer":"\"Yes, I use dental floss every day\".","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/18.mp3"},{"answer":"He told me that my teeth were healthy","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/19.mp3"},{"answer":"because I took very good care of them.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/20.mp3"},{"answer":"He left and told me to keep up the good work.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/21.mp3"},{"answer":"The dental hygienist came in,","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/22.mp3"},{"answer":"and she said that she would clean my teeth for me.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/23.mp3"},{"answer":"She scraped my teeth with a sharp tool,","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/24.mp3"},{"answer":"and then she put some polish on my teeth and began to clean them.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/25.mp3"},{"answer":"When she was done, she told me to spit into a bowl,","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/26.mp3"},{"answer":"and then I rinsed my mouth out with water.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/27.mp3"},{"answer":"I looked into a mirror and saw that my teeth were very shiny and white.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/28.mp3"},{"answer":"If I take care of my teeth, I'll have them forever.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/29.mp3"},{"answer":"I would like to keep my teeth healthy and white.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/30.mp3"},{"answer":"I like to smile.","audio":"https://dailydictation.com/upload/general-english/77-the-dentist-2019-03-29-12-54-10/31.mp3"}]
