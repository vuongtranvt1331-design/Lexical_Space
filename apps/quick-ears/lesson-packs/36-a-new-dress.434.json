[{"answer":"Who is it?","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/1.mp3"},{"answer":"It's me, dear.","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/2.mp3"},{"answer":"Don't you have your key?","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/3.mp3"},{"answer":"No, let me in!","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/4.mp3"},{"answer":"What's in that box? What did you get?","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/5.mp3"},{"answer":"A new dress, honey.","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/6.mp3"},{"answer":"But you have a closet full of dresses.","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/7.mp3"},{"answer":"I know, but I need a new one.","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/8.mp3"},{"answer":"What's wrong with all the other dresses?","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/9.mp3"},{"answer":"They're not this one!","audio":"https://dailydictation.com/upload/english-conversations/36-a-new-dress-2022-03-07-21-16-49/10.mp3"}]
