[{"answer":"Good morning, Scott and Smith Law Office. May I help you?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/1.mp3"},{"answer":"Yes. May I speak to David Waller, please?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/2.mp3"},{"answer":"I'm sorry, he isn't here yet. May I take a message?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/3.mp3"},{"answer":"Yes. Could you ask him to call Marjorie Vale?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/4.mp3"},{"answer":"How do you spell your last name?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/5.mp3"},{"answer":"V-A-L-E.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/6.mp3"},{"answer":"What's your phone number? Does Mr. Waller have it?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/7.mp3"},{"answer":"Uh, no, he doesn't.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/8.mp3"},{"answer":"It's 680-5290.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/9.mp3"},{"answer":"I'm sorry, could you repeat that?","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/10.mp3"},{"answer":"680-5290.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/11.mp3"},{"answer":"I'll give him the message.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/12.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/13.mp3"},{"answer":"You're welcome.","audio":"https://dailydictation.com/upload/english-conversations/72-on-the-phone-2022-03-07-21-28-20/14.mp3"}]
