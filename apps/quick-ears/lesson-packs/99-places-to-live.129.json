[{"answer":"I live in a house.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/1.mp3"},{"answer":"My house is in a town.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/2.mp3"},{"answer":"My uncle lives in an apartment building.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/3.mp3"},{"answer":"His apartment building is in a busy city.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/4.mp3"},{"answer":"My cousin lives in a dormitory in a school.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/5.mp3"},{"answer":"He shares his room with a classmate.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/6.mp3"},{"answer":"My uncle lives out in the country.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/7.mp3"},{"answer":"He lives on a farm.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/8.mp3"},{"answer":"The police caught a criminal.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/9.mp3"},{"answer":"Now the criminal lives in prison.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/10.mp3"},{"answer":"When I go to summer camp,","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/11.mp3"},{"answer":"I live in a tent.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/12.mp3"},{"answer":"When my parents go on vacation, they live in a motel or a hotel.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/13.mp3"},{"answer":"A motel only has one or two floors.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/14.mp3"},{"answer":"A hotel usually has many floors.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/15.mp3"},{"answer":"My aunt and uncle live in a trailer.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/16.mp3"},{"answer":"They like to move around from place to place.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/17.mp3"},{"answer":"My friends live in a cottage by a lake.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/18.mp3"},{"answer":"My grandfather lives in a retirement home.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/19.mp3"},{"answer":"Many people who are about the same age as he live there.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/20.mp3"},{"answer":"I would like to live in a palace.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/21.mp3"},{"answer":"I think you have to be a king or a queen, or a prince or a princess to live in a palace.","audio":"https://dailydictation.com/upload/general-english/99-places-to-live-2019-04-07-03-53-10/22.mp3"}]
