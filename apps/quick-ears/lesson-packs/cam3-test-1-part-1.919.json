[{"answer":"Hello... Flagstone.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/1.mp3"},{"answer":"Oh hello.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/2.mp3"},{"answer":"Is that Flagstone Properties?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/3.mp3"},{"answer":"Yes that's right.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/4.mp3"},{"answer":"Flagstone here. How can I help you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/5.mp3"},{"answer":"Hello.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/6.mp3"},{"answer":"I'm ringing just to make enquiries about renting a house.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/7.mp3"},{"answer":"My name's Jon Anderson.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/8.mp3"},{"answer":"Yes, Mr Anderson.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/9.mp3"},{"answer":"What sort of thing were you looking for?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/10.mp3"},{"answer":"Umm... Two-bedroomed house with garden.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/11.mp3"},{"answer":"Well... yes, sir, that shouldn't be any problem...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/12.mp3"},{"answer":"just to let you know that our main areas,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/13.mp3"},{"answer":"the main areas we deal with are the city centre itself...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/14.mp3"},{"answer":"City centre...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/15.mp3"},{"answer":"And the north suburbs.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/16.mp3"},{"answer":"Oh well...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/17.mp3"},{"answer":"we were most interested in the Northern areas actually.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/18.mp3"},{"answer":"Right... yes... What sort of price were you thinking of?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/19.mp3"},{"answer":"Well... uh... could you give me some idea?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/20.mp3"},{"answer":"Certainly.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/21.mp3"},{"answer":"It really ranges from £250 per month.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/22.mp3"},{"answer":"Only £250?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/23.mp3"},{"answer":"Yes, to about £500 depending on a number of different factors.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/24.mp3"},{"answer":"Oh, what does it depend on?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/25.mp3"},{"answer":"Well, obviously the quality of the area.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/26.mp3"},{"answer":"And then whether there's a garden.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/27.mp3"},{"answer":"Well, as I said, we'd want a garden.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/28.mp3"},{"answer":"And a garage pushes up the price.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/29.mp3"},{"answer":"Right...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/30.mp3"},{"answer":"well, we wouldn't necessarily need one.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/31.mp3"},{"answer":"I think about £350 a month would be our limit.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/32.mp3"},{"answer":"Okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/33.mp3"},{"answer":"Well... would you like to have a look at a couple of properties, sir?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/34.mp3"},{"answer":"Yes, that'd be great.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/35.mp3"},{"answer":"Um... Looking at our files... I think we've got two which might suit you...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/36.mp3"},{"answer":"Hang on. I'll just get a pen.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/37.mp3"},{"answer":"Right.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/38.mp3"},{"answer":"Okay. Well, there's one on West Park Road","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/39.mp3"},{"answer":"which is £325 a month.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/40-2024-10-24-12-17-57.mp3"},{"answer":"Are the bills included?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/41.mp3"},{"answer":"Well, that one just includes the water bill.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/42.mp3"},{"answer":"Okay, right.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/43.mp3"},{"answer":"And the second house is in Tithe Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/44.mp3"},{"answer":"I'll just spell that for you, okay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/45.mp3"},{"answer":"Yep.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/46.mp3"},{"answer":"TITHE Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/47.mp3"},{"answer":"Got that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/48.mp3"},{"answer":"And how much is that one?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/49.mp3"},{"answer":"That's £380.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/50.mp3"},{"answer":"380.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/51.mp3"},{"answer":"Uh... Is that including water?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/52.mp3"},{"answer":"No, I'm afraid not, but it does include the telephone rental.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/53.mp3"},{"answer":"Oh well, that's not too bad then.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/54.mp3"},{"answer":"So, when would you be available to see them?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/55.mp3"},{"answer":"Well, uh... I'll be in town next week... say... Thursday?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/56.mp3"},{"answer":"No, I'm sorry we don't have any availability for Thursday.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/57.mp3"},{"answer":"How about Wednesday afternoon?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/58.mp3"},{"answer":"Okay. That's fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/59.mp3"},{"answer":"Would 5 be okay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/60.mp3"},{"answer":"Yes, fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/61.mp3"},{"answer":"5 o'clock it is.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/62.mp3"},{"answer":"Just come to the Flagstone Offices.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/63.mp3"},{"answer":"Oh, before I forget.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/64.mp3"},{"answer":"What sort of things do I need to get done... to rent with you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/65.mp3"},{"answer":"Well, the most important thing is a letter from your bank...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/66.mp3"},{"answer":"No problem...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/67.mp3"},{"answer":"And then a reference letter from your employer.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/68.mp3"},{"answer":"Yes, that's okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/69.mp3"},{"answer":"Great, and then we would need you to give 2 weeks' notice of moving in...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/70.mp3"},{"answer":"Right... 2 weeks' notice.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/71.mp3"},{"answer":"And what about a deposit?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/72.mp3"},{"answer":"That's one month's rent, whatever the amount is.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/73.mp3"},{"answer":"Okay. One month.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/74.mp3"},{"answer":"Is that it?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/75.mp3"},{"answer":"No, sorry, one more...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/76.mp3"},{"answer":"you will have to pay for the contract.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/77-2024-10-24-12-22-41.mp3"},{"answer":"Oh yes. I'd forgotten about that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/78-2023-09-09-11-38-05.mp3"},{"answer":"Okay, fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/79.mp3"},{"answer":"So I'll start arranging those.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/80.mp3"},{"answer":"I'll see you next week.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/81.mp3"},{"answer":"Yes. Thanks very much.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/82.mp3"},{"answer":"Bye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/83.mp3"},{"answer":"Goodbye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-3-test-1-part-1-2023-08-14-20-25-50/84.mp3"}]
