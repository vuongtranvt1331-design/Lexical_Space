[{"answer":"Can I get you something to drink?","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/1.mp3"},{"answer":"A cup of coffee, please.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/2.mp3"},{"answer":"With milk and sugar?","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/3.mp3"},{"answer":"A little milk, but no sugar.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/4.mp3"},{"answer":"I never drink coffee at night.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/5.mp3"},{"answer":"Why not?","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/6.mp3"},{"answer":"It keeps me awake.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/7.mp3"},{"answer":"What do you drink with supper?","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/8.mp3"},{"answer":"Tea, it helps me relax.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/9.mp3"},{"answer":"I don't like tea.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/10.mp3"},{"answer":"There are so many kinds of tea;","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/11.mp3"},{"answer":"maybe you should shop around and try to find one you like","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/12.mp3"},{"answer":"because coffee is bad for you.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/13.mp3"},{"answer":"That's a good idea.","audio":"https://dailydictation.com/upload/english-conversations/45-a-cup-of-coffee-2022-03-07-21-20-04/14.mp3"}]
