[{"answer":"You sound terrible.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/1.mp3"},{"answer":"I have a sore throat.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/2.mp3"},{"answer":"You should rest your voice.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/3.mp3"},{"answer":"I know. It hurts when I talk.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/4.mp3"},{"answer":"What are you taking for your throat?","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/5.mp3"},{"answer":"Hot tea and honey.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/6.mp3"},{"answer":"That should help. Are you going to work today?","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/7.mp3"},{"answer":"No, I'm staying home.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/8.mp3"},{"answer":"Good idea.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/9.mp3"},{"answer":"I'll feel better tomorrow.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/10.mp3"},{"answer":"I hope so.","audio":"https://dailydictation.com/upload/english-conversations/47-i-have-a-sore-throat-2022-03-07-21-20-34/11.mp3"}]
