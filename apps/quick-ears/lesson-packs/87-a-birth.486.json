[{"answer":"Have you heard about the good news in the Wallace family?","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/1.mp3"},{"answer":"No, I've been out of town.","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/2.mp3"},{"answer":"Mrs Wallace went into the hospital last night and gave birth to a baby girl seven hours later.","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/3.mp3"},{"answer":"That's very good. But they already have a little girl, don't they?","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/4.mp3"},{"answer":"No, they have a 5-year-old boy.","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/5.mp3"},{"answer":"So they wanted a girl this time, right?","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/6.mp3"},{"answer":"Yes, they wanted a girl for a long time.","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/7.mp3"},{"answer":"Was it natural childbirth?","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/8.mp3"},{"answer":"No, she had to have a caesarean.","audio":"https://dailydictation.com/upload/english-conversations/87-a-birth-2022-03-07-21-34-29/9.mp3"}]
