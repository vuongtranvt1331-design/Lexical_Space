[{"answer":"Today is November 26th.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/1-2022-05-20-10-01-22.mp3"},{"answer":"It snowed all day today.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/2.mp3"},{"answer":"The snow is beautiful.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/3.mp3"},{"answer":"The snow finally stopped.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/4-2022-01-21-20-47-52.mp3"},{"answer":"My sister and I are excited.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/5.mp3"},{"answer":"My mom doesn't like the snow.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/6.mp3"},{"answer":"My mom has to shovel the driveway.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/7.mp3"},{"answer":"My sister and I get to play.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/8.mp3"},{"answer":"I put on my hat and mittens.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/9.mp3"},{"answer":"My mom puts on my scarf.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/10.mp3"},{"answer":"My mom zippers my jacket.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/11.mp3"},{"answer":"My sister puts on her hat and mittens.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/12.mp3"},{"answer":"My mom puts on her scarf.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/13.mp3"},{"answer":"My mom zippers her jacket.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/14.mp3"},{"answer":"My sister and I go outside.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/15.mp3"},{"answer":"We begin to make a snowman.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/16.mp3"},{"answer":"My mom starts to shovel the snow.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/17.mp3"},{"answer":"My sister and I make snow angels.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/18.mp3"},{"answer":"My sister and I throw snowballs.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/19.mp3"},{"answer":"It starts to snow again.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/20.mp3"},{"answer":"We go inside for hot chocolate.","audio":"https://dailydictation.com/upload/general-english/1-first-snowfall-2019-03-14-04-19-38/21.mp3"}]
