[{"answer":"When can I see Dr. Know?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/1.mp3"},{"answer":"He won't be free until tomorrow.","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/2.mp3"},{"answer":"Can I make an appointment?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/3.mp3"},{"answer":"Sure. How about tomorrow at ten o'clock?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/4.mp3"},{"answer":"Can you make it at nine?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/5.mp3"},{"answer":"I'll check to see if he's available.","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/6.mp3"},{"answer":"I'm sorry but he's tied up until ten o'clock.","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/7.mp3"},{"answer":"Well, can't you squeeze me in, somehow?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/8.mp3"},{"answer":"I'm afraid not.","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/9.mp3"},{"answer":"How about after lunch?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/10.mp3"},{"answer":"Will one o'clock be all right?","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/11.mp3"},{"answer":"That's perfect. Thank you.","audio":"https://dailydictation.com/upload/english-conversations/68-doctors-appointment-2022-03-07-21-27-16/12-2024-11-05-12-28-40.mp3"}]
