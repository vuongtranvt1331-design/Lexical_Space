[{"answer":"Where is your meeting?","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/1.mp3"},{"answer":"In Dallas, Texas.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/2.mp3"},{"answer":"How are you going?","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/3.mp3"},{"answer":"By plane.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/4.mp3"},{"answer":"Do you like to fly?","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/5.mp3"},{"answer":"Sure. It's fast and comfortable.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/6.mp3"},{"answer":"I'm afraid of flying.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/7.mp3"},{"answer":"That's silly. Flying is very safe.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/8.mp3"},{"answer":"Maybe, but I don't feel safe in a plane.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/9.mp3"},{"answer":"I understand. A lot of people feel that way.","audio":"https://dailydictation.com/upload/english-conversations/61-afraid-of-flying-2022-03-07-21-25-13/10.mp3"}]
