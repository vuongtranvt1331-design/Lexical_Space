[{"answer":"I'm very angry with my son, Harry.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/1.mp3"},{"answer":"Why? What's the problem?","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/2.mp3"},{"answer":"He's not doing well in school.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/3.mp3"},{"answer":"That's a surprise. Harry's a smart boy.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/4.mp3"},{"answer":"Yes, but he never studies.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/5.mp3"},{"answer":"Did you talk to his teachers?","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/6.mp3"},{"answer":"Yes, I did.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/7.mp3"},{"answer":"What did they say?","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/8.mp3"},{"answer":"He's a nice boy, but he's very lazy.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/9.mp3"},{"answer":"Maybe they're right.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/10.mp3"},{"answer":"I'm afraid so.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/11.mp3"},{"answer":"Have you thought about getting him a tutor?","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/12.mp3"},{"answer":"Maybe that's a good idea; I really want him to excel.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/13.mp3"},{"answer":"Let's go look in the phone book now then.","audio":"https://dailydictation.com/upload/english-conversations/34-a-lazy-boy-2022-03-07-21-16-00/14.mp3"}]
