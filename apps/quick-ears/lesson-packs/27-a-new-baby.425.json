[{"answer":"Well, hello, Mr Wallace.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/1.mp3"},{"answer":"You seem unusually happy today.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/2.mp3"},{"answer":"I just became a father!","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/3.mp3"},{"answer":"Congratulations. A boy or a girl?","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/4.mp3"},{"answer":"You never saw such a cute girl.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/5.mp3"},{"answer":"Nine pounds, three ounces... and as cute as a button.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/6.mp3"},{"answer":"Doesn't this call for cigars?","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/7.mp3"},{"answer":"Oh, yes. I forgot about the cigars. Here, have one.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/8.mp3"},{"answer":"Thank you. How's your wife?","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/9.mp3"},{"answer":"She's just fine.","audio":"https://dailydictation.com/upload/english-conversations/27-a-new-baby-2022-03-07-21-13-19/10.mp3"}]
