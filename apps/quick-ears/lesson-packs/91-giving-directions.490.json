[{"answer":"Now let's see... Vine Street is that way...","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/1.mp3"},{"answer":"Yes, just turn left at this corner.","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/2.mp3"},{"answer":"To Bridge Street?","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/3.mp3"},{"answer":"Is that street Bridge Street?","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/4.mp3"},{"answer":"Yes. There is a sign. Can you see that?","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/5.mp3"},{"answer":"Oh, you're right. Well, I have to go to Jay Street.","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/6.mp3"},{"answer":"I think the next one is Jay Street.","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/7.mp3"},{"answer":"Oh, right. Let's turn left at the next corner.","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/8.mp3"},{"answer":"Diana! This street is College Street, not Jay Street.","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/9.mp3"},{"answer":"Oh... uh, go straight ahead one more block!","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/10.mp3"},{"answer":"Are you sure? It's already 4:20!","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/11.mp3"},{"answer":"I should have taken a cab!","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/12.mp3"},{"answer":"That's gratitude for you!","audio":"https://dailydictation.com/upload/english-conversations/91-giving-directions-2022-03-07-21-35-46/13.mp3"}]
