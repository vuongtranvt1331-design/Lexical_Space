[{"answer":"Well, see you tomorrow.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/1.mp3"},{"answer":"I'd better go, too.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/2-2022-03-08-20-04-15.mp3"},{"answer":"Oh, would you do me a favour?","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/3.mp3"},{"answer":"Sure.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/4.mp3"},{"answer":"Would you call me tomorrow at six o'clock in the morning?","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/5.mp3"},{"answer":"Tomorrow's my daughter's birthday. I wanna get her a new robe,","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/6.mp3"},{"answer":"and I have to pick up the dry cleaning, and pick up the cake from the bakery.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/7.mp3"},{"answer":"Anyway, I have lots of things to do.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/8.mp3"},{"answer":"But I'm not sure I can get up early.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/9-2022-03-08-20-07-11.mp3"},{"answer":"Do you need a hand?","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/10.mp3"},{"answer":"Oh, can you? That would be great.","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/11.mp3"},{"answer":"Can you go to the mall and buy her a new robe,","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/12.mp3"},{"answer":"pick up the dry cleaning, and get the cake from the bakery?","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/13.mp3"},{"answer":"And what will you be doing?","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/14.mp3"},{"answer":"Sleeping in of course!","audio":"https://dailydictation.com/upload/english-conversations/42-would-you-call-me-2022-03-07-21-18-59/15.mp3"}]
