[{"answer":"Today I was working outside.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/1.mp3"},{"answer":"It was a sunny day,","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/2.mp3"},{"answer":"and I was very hot.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/3.mp3"},{"answer":"I wore a hat on my head.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/4.mp3"},{"answer":"I watered all the plants.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/5.mp3"},{"answer":"I weeded the flower beds.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/6.mp3"},{"answer":"I cut back all of the plants that were growing too big.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/7.mp3"},{"answer":"I gave some of the plants plant food.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/8.mp3"},{"answer":"I cut the lawn.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/9.mp3"},{"answer":"I raked the lawn.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/10.mp3"},{"answer":"I filled up the bird baths with water.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/11.mp3"},{"answer":"I swept the sidewalks and the paths.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/12.mp3"},{"answer":"I took out the garbage.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/13.mp3"},{"answer":"I filled the car up with gas.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/14.mp3"},{"answer":"I washed the car.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/15.mp3"},{"answer":"I hung out the clothes on the clothesline.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/16.mp3"},{"answer":"I washed down the lawn furniture.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/17.mp3"},{"answer":"I washed all of the windows on the house from the outside.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/18.mp3"},{"answer":"I was so tired.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/19.mp3"},{"answer":"So I had a glass of lemonade.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/20.mp3"},{"answer":"I talked to my neighbor,","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/21.mp3"},{"answer":"and I helped her trim a tree.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/22.mp3"},{"answer":"I planted some bulbs,","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/23.mp3"},{"answer":"and then I went into the house.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/24.mp3"},{"answer":"I was exhausted.","audio":"https://dailydictation.com/upload/general-english/20-working-outside-2019-03-20-08-39-58/25.mp3"}]
