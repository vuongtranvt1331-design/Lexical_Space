[{"answer":"Do you smoke? I've never known that.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/1.mp3"},{"answer":"When did you start smoking?","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/2.mp3"},{"answer":"I started smoking when I was eighteen.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/3.mp3"},{"answer":"So, how long have you been a smoker?","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/4.mp3"},{"answer":"I've smoked for twenty years.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/5.mp3"},{"answer":"How many cigarettes do you smoke a day?","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/6.mp3"},{"answer":"I smoke two packs of cigarettes a day.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/7.mp3"},{"answer":"Have you ever tried to quit?","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/8-2022-03-10-11-53-09.mp3"},{"answer":"Yes, I have quit twice: once when I was expecting my baby, Paul,","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/9-2022-03-10-11-53-18.mp3"},{"answer":"and the other time when I had a bad sore throat.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/10.mp3"},{"answer":"But I had a hard time.","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/11.mp3"},{"answer":"If you knew what it was doing to your lungs,","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/12.mp3"},{"answer":"you would think twice about it!","audio":"https://dailydictation.com/upload/english-conversations/85-smoking-2022-03-07-21-32-40/13.mp3"}]
