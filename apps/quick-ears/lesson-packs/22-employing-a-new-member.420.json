[{"answer":"Well, this woman may be suitable for the job.","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/1.mp3"},{"answer":"But is she energetic enough?","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/2.mp3"},{"answer":"Yes, she certainly seems to have lots of energy.","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/3.mp3"},{"answer":"Mmm. She's got to be ambitious too. Is she?","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/4.mp3"},{"answer":"Yes, she has plenty of ambition.","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/5.mp3"},{"answer":"And we really need a flexible sort of person. Do you think she is?","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/6.mp3"},{"answer":"Mmm. She seems to be determined enough, but she's a little tough.","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/7.mp3"},{"answer":"Well I guess we'll give her a try, and see how she works out!","audio":"https://dailydictation.com/upload/english-conversations/22-employing-a-new-member-2022-03-07-21-11-36/8.mp3"}]
