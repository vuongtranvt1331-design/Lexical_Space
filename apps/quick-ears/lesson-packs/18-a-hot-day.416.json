[{"answer":"This heat is killing me!","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/1.mp3"},{"answer":"Me too! It must be 95 degrees.","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/2.mp3"},{"answer":"I would like a cold drink.","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/3.mp3"},{"answer":"I'll get you one.","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/4.mp3"},{"answer":"Thanks.","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/5.mp3"},{"answer":"Mmm. This tastes good!","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/6.mp3"},{"answer":"It does, jeez, this hot weather makes me lazy.","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/7.mp3"},{"answer":"Me too, get me another drink?","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/8.mp3"},{"answer":"I guess if you're lazy no one else is allowed to be!","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/9.mp3"},{"answer":"He he he, thanks for understanding!","audio":"https://dailydictation.com/upload/english-conversations/18-a-hot-day-2022-03-07-21-09-57/10.mp3"}]
