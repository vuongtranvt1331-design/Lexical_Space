[{"answer":"Where's Kevin?","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/1.mp3"},{"answer":"He's in front of the house.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/2.mp3"},{"answer":"What is he doing?","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/3.mp3"},{"answer":"Washing his car.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/4.mp3"},{"answer":"Not again?","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/5.mp3"},{"answer":"Yes, he takes good care of his car.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/6.mp3"},{"answer":"But he never cleans his room.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/7.mp3"},{"answer":"I know. It's always dirty.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/8.mp3"},{"answer":"And nothing is in order.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/9.mp3"},{"answer":"You're right. His room is a mess.","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/10.mp3"},{"answer":"Maybe he should move into the car!","audio":"https://dailydictation.com/upload/english-conversations/29-washing-his-car-2022-03-07-21-13-49/11.mp3"}]
