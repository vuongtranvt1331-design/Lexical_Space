[{"answer":"We have many international students at my school.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/1.mp3"},{"answer":"Some of the students come from England.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/2.mp3"},{"answer":"They speak English, but they have an accent that is different from a Canadian accent.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/3.mp3"},{"answer":"Many students are from Japan.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/4.mp3"},{"answer":"They are learning our language and our customs.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/5.mp3"},{"answer":"We have students from Germany, Italy, China, Korea and Iran.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/6.mp3"},{"answer":"We try to make those students feel welcome here.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/7.mp3"},{"answer":"The students like to see what is here.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/8.mp3"},{"answer":"They go sightseeing.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/9.mp3"},{"answer":"They visit all the places that the tourists like to go to.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/10.mp3"},{"answer":"Niagara Falls and Toronto are interesting places to visit.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/11.mp3"},{"answer":"The students practice their English by talking to Canadians.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/12.mp3"},{"answer":"When they first get here, we show them around.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/13.mp3"},{"answer":"They do many exercises to learn the language.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/14.mp3"},{"answer":"They listen to English songs.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/15.mp3"},{"answer":"They read story books that are written in English.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/16.mp3"},{"answer":"They listen to English language tapes.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/17.mp3"},{"answer":"The best way to learn the language is to talk to other people.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/18.mp3"},{"answer":"It is good to ask questions in English.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/19.mp3"},{"answer":"Canadians try to be helpful to international students.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/20.mp3"},{"answer":"Some of the international students live with host families.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/21.mp3"},{"answer":"The host families have the students living in their homes.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/22.mp3"},{"answer":"It is a good way for the host families and the students to make friends.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/23.mp3"},{"answer":"Many of the international students stay in contact with their friends and host families","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/24.mp3"},{"answer":"even after they have gone back to their homelands.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/25.mp3"},{"answer":"The international students learn a lot from their host families","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/26.mp3"},{"answer":"because they eat Canadian foods,","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/27.mp3"},{"answer":"and they learn what it is like to live in a Canadian household.","audio":"https://dailydictation.com/upload/general-english/28-international-students-2019-03-20-09-11-26/28.mp3"}]
