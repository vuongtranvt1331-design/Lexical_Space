[{"answer":"Umm. Something smells good!","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/1.mp3"},{"answer":"My friend's mom is making cookies.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/2.mp3"},{"answer":"They are chocolate chip, my favorite!","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/3.mp3"},{"answer":"I think I'll go home and ask my mom if we can make cookies, too.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/4.mp3"},{"answer":"I run all the way home and rush through the door.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/5.mp3"},{"answer":"I yell, \"Mom, Mom!\"","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/6.mp3"},{"answer":"She comes out from her bedroom, her eyes wide.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/7.mp3"},{"answer":"\"What?\" she answers, a little worried.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/8.mp3"},{"answer":"I breathlessly ask if we can please, pretty please, make cookies.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/9.mp3"},{"answer":"She smiles and says, \"I guess so\".","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/10.mp3"},{"answer":"\"YES!\" I reply.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/11.mp3"},{"answer":"First mom tells me to get out the cooking stuff;","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/12.mp3"},{"answer":"so I get out the mixer and bowl,","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/13.mp3"},{"answer":"the measuring cups and spoons and the cookie sheets.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/14.mp3"},{"answer":"Then she tells me to get out the recipe book.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/15.mp3"},{"answer":"I remind her that the recipe is on the chocolate chip package.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/16.mp3"},{"answer":"\"Right,\" she says.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/17.mp3"},{"answer":"Then she asks me to look at the recipe and get out the things we need:","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/18.mp3"},{"answer":"like flour, sugar and butter.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/19.mp3"},{"answer":"We set the oven temperature to 350 degrees Fahrenheit.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/20.mp3"},{"answer":"Then, we mix all of the flour and other stuff (ingredients) together.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/21.mp3"},{"answer":"Last, we added the chocolate chips.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/22.mp3"},{"answer":"We drop the batter by big teaspoons full onto the cookie sheets.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/23.mp3"},{"answer":"We set the timer for twelve minutes","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/24.mp3"},{"answer":"and just sit back and enjoy the good smell!","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/25.mp3"},{"answer":"The buzzer rings. We take the cookies out.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/26.mp3"},{"answer":"Oh, do they look good!","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/27.mp3"},{"answer":"We don't even wait for them to cool down.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/28.mp3"},{"answer":"Both Mom and I get a big glass of cold milk and two big warm cookies each.","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/29.mp3"},{"answer":"Yum! Yum! Want to join us?!","audio":"https://dailydictation.com/upload/general-english/132-making-cookies-2019-04-07-04-23-10/30.mp3"}]
