[{"answer":"Do you ever think about your emotions?","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/1.mp3"},{"answer":"What kinds of things make you sad?","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/2.mp3"},{"answer":"I get sad when I get a bad mark in school","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/3.mp3"},{"answer":"or when someone that I like moves away.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/4.mp3"},{"answer":"I sometimes see sad movies that make me cry.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/5.mp3"},{"answer":"I don't like to be sad.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/6.mp3"},{"answer":"I don't like to have a frown on my face.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/7.mp3"},{"answer":"I like to be happy. I'm happy most of the time.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/8.mp3"},{"answer":"Parties make me happy.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/9.mp3"},{"answer":"Being with my friends makes me happy.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/10.mp3"},{"answer":"Lots of things make me happy.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/11.mp3"},{"answer":"If someone tells me a joke, I laugh.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/12.mp3"},{"answer":"I enjoy laughing.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/13.mp3"},{"answer":"Funny movies make me laugh.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/14.mp3"},{"answer":"I think that people look the best when they smile.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/15.mp3"},{"answer":"What kinds of things make you mad?","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/16.mp3"},{"answer":"I get mad when my brother breaks one of my toys.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/17.mp3"},{"answer":"I try not to show it when I get mad.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/18.mp3"},{"answer":"My parents get mad at me if I come home late.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/19.mp3"},{"answer":"I don't think anger is a good emotion.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/20.mp3"},{"answer":"It is best to stay calm and talk things over.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/21.mp3"},{"answer":"Emotions come from inside you,","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/22.mp3"},{"answer":"but they show on your face.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/23.mp3"},{"answer":"People can tell when you're mad, or sad or happy.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/24.mp3"},{"answer":"I prefer to look happy.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/25.mp3"},{"answer":"Sometimes I even smile when I'm feeling sad,","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/26.mp3"},{"answer":"and the smile makes me feel a little better.","audio":"https://dailydictation.com/upload/general-english/79-emotions-2019-03-29-12-55-01/27.mp3"}]
