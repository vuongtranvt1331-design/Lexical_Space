[{"answer":"Mr. Adams, have you seen this ad in the Recruit News?","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/1.mp3"},{"answer":"Yes, I saw it, but I'm not interested in finding a new job.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/2.mp3"},{"answer":"I've been here since I graduated from my university.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/3.mp3"},{"answer":"I like working here.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/4.mp3"},{"answer":"Really? I've only been here one year, and I'm already tired of doing the same thing every day.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/5.mp3"},{"answer":"I'm afraid of getting really bored.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/6.mp3"},{"answer":"Oh, come on! It's not that bad.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/7.mp3"},{"answer":"Wherever you work, you have to do the same thing every day to a certain degree.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/8.mp3"},{"answer":"Well, what's more, I've been working about ten hours a day since last month.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/9.mp3"},{"answer":"But you've been getting paid more money for it, haven't you?","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/10.mp3"},{"answer":"Yes, but I'm not interested in making more money.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/11.mp3"},{"answer":"I'm going to apply for another job.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/12.mp3"},{"answer":"What kind of job?","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/13.mp3"},{"answer":"A secretarial job.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/14.mp3"},{"answer":"Well, good luck.","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/15.mp3"},{"answer":"Thank you very much!","audio":"https://dailydictation.com/upload/english-conversations/83-a-new-job-2022-03-07-21-31-53/16.mp3"}]
