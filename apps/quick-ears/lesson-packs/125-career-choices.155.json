[{"answer":"What do you want to be when you grow up?","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/1.mp3"},{"answer":"There are so many things that you can be.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/2.mp3"},{"answer":"You might want to work in the field of law.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/3.mp3"},{"answer":"You could be a police officer.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/4.mp3"},{"answer":"You could be a judge or a lawyer.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/5.mp3"},{"answer":"Maybe you'd like to work in the food industry.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/6.mp3"},{"answer":"You could be a cook or a waitress.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/7.mp3"},{"answer":"You might want to manage a hotel dining room.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/8.mp3"},{"answer":"Perhaps you would want to do room service in a hotel.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/9.mp3"},{"answer":"You could be a chef and make fancy meals for people.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/10.mp3"},{"answer":"Maybe show business is what you'd like to be involved in.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/11.mp3"},{"answer":"You could act in television shows or movies.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/12.mp3"},{"answer":"You could sing or play an instrument in a band.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/13.mp3"},{"answer":"If you like to help people, you could go into medicine.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/14.mp3"},{"answer":"You could be a doctor or a nurse.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/15.mp3"},{"answer":"You might be a surgeon and operate on people.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/16.mp3"},{"answer":"There are other jobs in the field of medicine too.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/17.mp3"},{"answer":"You could be an x-ray technician or a lab technician.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/18.mp3"},{"answer":"It takes a lot of education to be a doctor.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/19.mp3"},{"answer":"Maybe you would rather be a teacher.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/20.mp3"},{"answer":"You could teach in a primary school or a high school.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/21.mp3"},{"answer":"If you don't want to work with children,","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/22.mp3"},{"answer":"you could become a professor at a university.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/23.mp3"},{"answer":"There are hundreds of other jobs to choose from too.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/24.mp3"},{"answer":"You might want to fix cars or work in a store.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/25.mp3"},{"answer":"You could be a dentist or a veterinarian.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/26.mp3"},{"answer":"You could be a janitor or a zookeeper.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/27.mp3"},{"answer":"There are so many jobs that I just can't name them all.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/28.mp3"},{"answer":"Maybe you'd like to be a minister or an organist at a church.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/29.mp3"},{"answer":"You could be a babysitter or a shop clerk.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/30.mp3"},{"answer":"You might be interested in being an astronaut or a baker.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/31.mp3"},{"answer":"You could work in a bank or at a shop.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/32.mp3"},{"answer":"You could work on a construction crew and build roads and houses.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/33.mp3"},{"answer":"Maybe you'd rather decorate the houses,","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/34.mp3"},{"answer":"so you could become an interior decorator.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/35.mp3"},{"answer":"You could cut hair or be a driving instructor.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/36.mp3"},{"answer":"The list is endless.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/37.mp3"},{"answer":"There are even jobs that you may never have heard about.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/38.mp3"},{"answer":"The choice is yours.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/39.mp3"},{"answer":"You just choose whatever you want to be and do your best to become that.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/40.mp3"},{"answer":"I could go on forever.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/41.mp3"},{"answer":"you could work in a library.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/42.mp3"},{"answer":"You could be a factory worker or a fisherman.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/43.mp3"},{"answer":"You could make clothes or build bridges.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/44.mp3"},{"answer":"You could wash windows or be a bricklayer.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/45.mp3"},{"answer":"The possibilities are endless.","audio":"https://dailydictation.com/upload/general-english/125-career-choices-2019-04-07-04-20-50/46.mp3"}]
