[{"answer":"Excuse me. I'm trying to find the nearest post office.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/1.mp3"},{"answer":"Can you help me?","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/2.mp3"},{"answer":"Sure. It's not far from here.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/3.mp3"},{"answer":"Just go straight down this road for about three blocks.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/4.mp3"},{"answer":"You'll see a bakery on your right.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/5.mp3"},{"answer":"The post office is right next to it,","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/6.mp3"},{"answer":"you can't miss it.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/7.mp3"},{"answer":"Thank you! Do you know what time it closes?","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/8.mp3"},{"answer":"I think it closes at 5 PM.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/9.mp3"},{"answer":"You should have plenty of time if you go now.","audio":"https://dailydictation.com/upload/toeic/conversation-where-is-the-post-office-2024-07-21-17-19-00/10.mp3"}]
