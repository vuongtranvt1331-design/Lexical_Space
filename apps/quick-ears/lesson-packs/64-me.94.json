[{"answer":"I am special - nobody in the world is exactly like I am.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/1.mp3"},{"answer":"They might have the same hair color and eyes that I do,","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/2.mp3"},{"answer":"but they are not exactly like me.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/3.mp3"},{"answer":"I am the only person in the world who thinks my thoughts.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/4.mp3"},{"answer":"No two people in the world are exactly alike.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/5.mp3"},{"answer":"It is good to be your own person.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/6.mp3"},{"answer":"It is good to be creative and be natural.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/7.mp3"},{"answer":"People have to follow the laws and the rules.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/8.mp3"},{"answer":"People should always be kind to others.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/9.mp3"},{"answer":"I try to follow all the rules.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/10.mp3"},{"answer":"I am kind to others.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/11.mp3"},{"answer":"I am a lot like many other people, yet I am different.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/12.mp3"},{"answer":"I am like my friend Jane,","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/13.mp3"},{"answer":"but she has red hair and I have dark hair.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/14.mp3"},{"answer":"She has a loud voice, and I have a soft voice.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/15.mp3"},{"answer":"She likes to eat vegetables, and I do not.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/16.mp3"},{"answer":"Jane and I are the same height.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/17.mp3"},{"answer":"We both like movies, and we are both afraid of spiders.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/18.mp3"},{"answer":"We wear the same size shoes, and we both have the same favorite color.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/19.mp3"},{"answer":"We are best friends, but sometimes we disagree about things.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/20.mp3"},{"answer":"We are alike in many ways, and different in many ways.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/21.mp3"},{"answer":"If we were all exactly the same,","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/22.mp3"},{"answer":"the world would be a very boring place.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/23.mp3"},{"answer":"I am myself, and I am glad that I am special.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/24.mp3"},{"answer":"You are special too.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/25.mp3"},{"answer":"Use your own special talents, and take the time to meet other people.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/26.mp3"},{"answer":"The world is made up of a lot of different people,","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/27.mp3"},{"answer":"and that's what makes life exciting.","audio":"https://dailydictation.com/upload/general-english/64-me-2019-03-29-12-42-14/28.mp3"}]
