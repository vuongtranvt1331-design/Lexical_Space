[{"answer":"Sara, you can't park here! It's a bus stop.","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/1.mp3"},{"answer":"Oh, we'll be back in a few minutes. It's OK.","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/2.mp3"},{"answer":"Oh, no, it isn't. You'll get a parking ticket if you leave it here.","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/3.mp3"},{"answer":"No, I won't. It's 5:30. All the traffic wardens have gone home.","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/4.mp3"},{"answer":"Sara!","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/5.mp3"},{"answer":"Yes?","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/6.mp3"},{"answer":"Is this your car, ma'am?","audio":"https://dailydictation.com/upload/english-conversations/39-traffic-rules-1-2022-03-07-21-18-00/7.mp3"}]
