[{"answer":"Hello, Jack. This is Dave.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/1.mp3"},{"answer":"I want to return the book I borrowed from you last night.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/2.mp3"},{"answer":"Will you be home at about six o'clock?","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/3.mp3"},{"answer":"Yes, I will. I'll be cooking dinner.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/4.mp3"},{"answer":"Oh! Well. Then I won't come over at six.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/5.mp3"},{"answer":"Why not?","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/6.mp3"},{"answer":"I don't want to disturb you.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/7.mp3"},{"answer":"Don't worry! You won't disturb me.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/8.mp3"},{"answer":"OK. I'll see you at six.","audio":"https://dailydictation.com/upload/english-conversations/10-telephone-call-2022-03-07-20-54-21/9.mp3"}]
