[{"answer":"Hey! What's the matter with the phone?","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/1.mp3"},{"answer":"Here, listen to this peculiar noise.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/2.mp3"},{"answer":"It doesn't sound like a dial tone.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/3.mp3"},{"answer":"It must be out of order.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/4.mp3"},{"answer":"We'd better notify the phone company.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/5.mp3"},{"answer":"How do we do that? We can't use the phone.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/6.mp3"},{"answer":"Let's go next door and use our neighbour's phone.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/7.mp3"},{"answer":"He's always complaining about people. I don't wanna ask any favours of him.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/8.mp3"},{"answer":"How about across the street?","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/9.mp3"},{"answer":"I forgot about Mrs. Riley! I'm sure she'd let us use her phone.","audio":"https://dailydictation.com/upload/english-conversations/20-phone-out-of-order-2-2022-03-07-21-11-02/10.mp3"}]
