[{"answer":"How about a drink, tonight?","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/1.mp3"},{"answer":"I'd love to.","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/2.mp3"},{"answer":"Where can we meet?","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/3.mp3"},{"answer":"How about the Relax Bar?","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/4.mp3"},{"answer":"All right. What time?","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/5.mp3"},{"answer":"Is eight o'clock OK?","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/6.mp3"},{"answer":"Yes that's fine.","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/7.mp3"},{"answer":"I will meet you there; I'm really looking forward to it!","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/8.mp3"},{"answer":"Me too!","audio":"https://dailydictation.com/upload/english-conversations/46-how-about-a-drink-2022-03-07-21-20-21/9.mp3"}]
