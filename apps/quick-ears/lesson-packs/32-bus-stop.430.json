[{"answer":"Jean!","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/1.mp3"},{"answer":"Barbara! Do you work around here?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/2.mp3"},{"answer":"Yes, I work in that building across the street.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/3.mp3"},{"answer":"Really? What do you do?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/4.mp3"},{"answer":"I work in a law office, I'm a secretary.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/5.mp3"},{"answer":"Oh, that's interesting.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/6.mp3"},{"answer":"What about you? What do you do?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/7.mp3"},{"answer":"I work at Duru Restaurant.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/8.mp3"},{"answer":"Oh... are you a cook?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/9.mp3"},{"answer":"No, I'm a waitress.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/10.mp3"},{"answer":"That's a really hard job; I don't envy you.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/11.mp3"},{"answer":"Me neither!","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/12.mp3"},{"answer":"Do you live alone, Jean?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/13.mp3"},{"answer":"No, I don't. I live with my family. How about you?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/14.mp3"},{"answer":"I'm married now. I got married last year.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/15.mp3"},{"answer":"Really? Congratulations! Who did you marry?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/16.mp3"},{"answer":"His name's Jeff Hunt. He lives in my building.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/17.mp3"},{"answer":"Oh, what does he do?","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/18.mp3"},{"answer":"He's a doctor.","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/19.mp3"},{"answer":"How wonderful, I'm very happy for you!","audio":"https://dailydictation.com/upload/english-conversations/32-bus-stop-2022-03-07-21-14-34/20.mp3"}]
