[{"answer":"Mrs, Martin? I'm Dr. Thomas.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/1.mp3"},{"answer":"Oh, doctor, how is he?","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/2.mp3"},{"answer":"Well, I'm afraid we'll have to operate.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/3.mp3"},{"answer":"Oh, no! He's always been afraid of operations.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/4.mp3"},{"answer":"Don't worry. If we operate now, he'll be all right.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/5.mp3"},{"answer":"Oh, doctor, do you really have to?","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/6.mp3"},{"answer":"I'm afraid so. He's lost a lot of blood.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/7.mp3"},{"answer":"If we don't operate, he'll die!","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/8.mp3"},{"answer":"Oh, please do whatever you have to.","audio":"https://dailydictation.com/upload/english-conversations/73-operating-room-2022-03-07-21-28-36/9.mp3"}]
