[{"answer":"Here are some questions that you might be asked.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/1.mp3"},{"answer":"And some responses that you might make.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/2.mp3"},{"answer":"Hello, how are you today?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/3.mp3"},{"answer":"I am fine, thanks! How are you?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/4.mp3"},{"answer":"It is a beautiful day today, isn't it?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/5.mp3"},{"answer":"Yes, it is a lovely day.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/6.mp3"},{"answer":"I wish the weather would clear up, don't you?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/7.mp3"},{"answer":"Yes, I'm getting tired of all this rain.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/8.mp3"},{"answer":"How old are you?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/9.mp3"},{"answer":"I am 12 years old.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/10.mp3"},{"answer":"Where are you going?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/11.mp3"},{"answer":"I am going to my friend's house.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/12.mp3"},{"answer":"Do you know how much this costs?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/13.mp3"},{"answer":"Yes, it costs $12.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/14.mp3"},{"answer":"What is your name?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/15.mp3"},{"answer":"My name is Mary Jones.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/16.mp3"},{"answer":"Would you like a ride to school?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/17.mp3"},{"answer":"No, thank you. I never accept rides from strangers.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/18.mp3"},{"answer":"How do I get to main street?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/19.mp3"},{"answer":"Turn right at the next corner, walk about two blocks and you will see main street.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/20.mp3"},{"answer":"Have you seen that movie?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/21.mp3"},{"answer":"No, but I have heard that it is very good.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/22.mp3"},{"answer":"What is your favorite color?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/23.mp3"},{"answer":"My favorite color is blue.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/24.mp3"},{"answer":"Is your father home?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/25.mp3"},{"answer":"Yes, just a minute, I will get him for you.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/26.mp3"},{"answer":"May I help you?","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/27.mp3"},{"answer":"Yes, I am looking for the shoe department.","audio":"https://dailydictation.com/upload/general-english/49-questions-and-answers-2019-03-29-10-19-31/28.mp3"}]
