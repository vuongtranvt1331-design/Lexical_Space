[{"answer":"Do you know what's on the menu at the cafeteria today?","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/1.mp3"},{"answer":"They have grilled chicken,","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/2.mp3"},{"answer":"a vegetarian pasta,","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/3.mp3"},{"answer":"and a soup of the day.","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/4.mp3"},{"answer":"Do you know if they have any gluten-free options?","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/5.mp3"},{"answer":"I'm trying to avoid gluten.","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/6.mp3"},{"answer":"Let me check...","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/7.mp3"},{"answer":"Okay, the grilled chicken is gluten-free.","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/8.mp3"},{"answer":"They also have a quinoa salad that should be safe.","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/9.mp3"},{"answer":"Great, thanks!","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/10.mp3"},{"answer":"Do you have any idea what the soup of the day is?","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/11.mp3"},{"answer":"I think it's mushroom soup,","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/12.mp3"},{"answer":"but you might want to ask them to be sure.","audio":"https://dailydictation.com/upload/toeic/conversation-cafeteria-menu-2024-07-21-17-33-24/13.mp3"}]
