[{"answer":"Did you take the bus to work today?","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/1.mp3"},{"answer":"Yes, I did.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/2.mp3"},{"answer":"It was on time today.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/3.mp3"},{"answer":"How about you?","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/4.mp3"},{"answer":"I took the subway.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/5.mp3"},{"answer":"It was a bit crowded but faster than the bus.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/6.mp3"},{"answer":"Do you think you'll keep using the subway or try the bus sometime?","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/7.mp3"},{"answer":"I'm not sure.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/8.mp3"},{"answer":"The subway is faster, but the bus has nice views.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/9.mp3"},{"answer":"I understand.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/10.mp3"},{"answer":"Both have good and bad points.","audio":"https://dailydictation.com/upload/toeic/conversation-using-public-transportation-2024-07-21-17-31-23/11.mp3"}]
