[{"answer":"Does it take long to get a visa?","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/1.mp3"},{"answer":"It depends on the season. Anywhere from one month to two months.","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/2.mp3"},{"answer":"What do I need to do?","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/3.mp3"},{"answer":"Fill out an application form and wait.","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/4.mp3"},{"answer":"Will there be a long waiting period?","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/5.mp3"},{"answer":"Not if you don't run into any government delays.","audio":"https://dailydictation.com/upload/english-conversations/21-getting-a-visa-2022-03-07-21-11-20/6.mp3"}]
