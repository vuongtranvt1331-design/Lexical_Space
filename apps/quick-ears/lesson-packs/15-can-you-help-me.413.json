[{"answer":"Can you help me, officer?","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/1.mp3"},{"answer":"I'll try. What's the problem?","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/2.mp3"},{"answer":"I can't get into my car.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/3.mp3"},{"answer":"Where are your keys?","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/4.mp3"},{"answer":"They're in the car.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/5.mp3"},{"answer":"Don't worry. I can open it.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/6.mp3"},{"answer":"How can you do that?","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/7.mp3"},{"answer":"With a coat hanger. It's easy.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/8.mp3"},{"answer":"Where can we get a coat hanger?","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/9.mp3"},{"answer":"There's one in the police car. Wait here.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/10.mp3"},{"answer":"Thanks a lot! You're very kind.","audio":"https://dailydictation.com/upload/english-conversations/15-can-you-help-me-2022-03-07-21-09-09/11.mp3"}]
