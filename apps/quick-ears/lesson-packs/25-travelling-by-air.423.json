[{"answer":"Do I check in here for Air Canada to Mexico?","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/1.mp3"},{"answer":"You already have your ticket?","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/2.mp3"},{"answer":"Yes. Here you are.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/3.mp3"},{"answer":"Thank you. Can you put your luggage up here, please?","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/4.mp3"},{"answer":"Sure, I have three suitcases.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/5.mp3"},{"answer":"We allow only two pieces. You'll have to pay an extra charge.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/6.mp3"},{"answer":"Oh! Can I carry this one with me?","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/7.mp3"},{"answer":"No, I'm sorry. It won't fit under your seat.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/8.mp3"},{"answer":"That's $45.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/9.mp3"},{"answer":"Here you are.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/10.mp3"},{"answer":"Thank you. You can choose your seat.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/11.mp3"},{"answer":"A window seat or aisle seat?","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/12.mp3"},{"answer":"I'd like a window seat, please.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/13.mp3"},{"answer":"Fine. Seat 15A.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/14.mp3"},{"answer":"Here's your ticket and your boarding pass.","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/15.mp3"},{"answer":"Enjoy your flight!","audio":"https://dailydictation.com/upload/english-conversations/25-travelling-by-air-2022-03-07-21-12-42/16.mp3"}]
