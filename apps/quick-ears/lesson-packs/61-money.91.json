[{"answer":"I keep my money in the bank.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/1.mp3"},{"answer":"I have saved up my money.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/2.mp3"},{"answer":"I saved all my pennies in a jar.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/3.mp3"},{"answer":"A penny is only worth one cent.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/4.mp3"},{"answer":"I have nickels. A nickel is worth five cents.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/5.mp3"},{"answer":"A dime is worth ten cents.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/6.mp3"},{"answer":"A quarter is worth twenty-five cents.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/7.mp3"},{"answer":"A quarter is a quarter of a dollar.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/8.mp3"},{"answer":"Four quarters make up a dollar.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/9.mp3"},{"answer":"A dollar is worth 100 cents.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/10.mp3"},{"answer":"I saved up all of my dollars.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/11.mp3"},{"answer":"Our dollars used to be paper, but now they are coins.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/12.mp3"},{"answer":"We call our dollars loonies. It's a funny name.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/13.mp3"},{"answer":"We also have 2 dollar coins. We call those toonies.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/14.mp3"},{"answer":"We have 5 dollar bills and 10 dollar bills.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/15.mp3"},{"answer":"If you are lucky you will have 20 dollar bills, 50 dollar bills and even hundred dollar bills.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/16.mp3"},{"answer":"Our bills in Canada are different colors.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/17.mp3"},{"answer":"That makes them easy to recognize if you go somewhere to spend them.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/18.mp3"},{"answer":"It is wise to save your money.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/19.mp3"},{"answer":"If you save enough, you could have hundreds or thousands of dollars.","audio":"https://dailydictation.com/upload/general-english/61-money-2019-03-29-10-28-19/20.mp3"}]
