[{"answer":"We are having Thanksgiving at our house.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/1.mp3"},{"answer":"My whole family is coming.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/2.mp3"},{"answer":"My parents bought a turkey.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/3.mp3"},{"answer":"It weighs 30 pounds.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/4.mp3"},{"answer":"It takes a long time to cook.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/5.mp3"},{"answer":"My mom wakes up early to cook the turkey.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/6.mp3"},{"answer":"I clean the house with my dad.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/7.mp3"},{"answer":"The house smells good.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/8.mp3"},{"answer":"We help Mom in the kitchen.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/9.mp3"},{"answer":"I peel potatoes and carrots.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/10.mp3"},{"answer":"My dad makes pumpkin pies.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/11.mp3"},{"answer":"My mom cooks squash.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/12.mp3"},{"answer":"I help my mom make stuffing.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/13.mp3"},{"answer":"I mix the bread and spices.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/14.mp3"},{"answer":"We make good stuffing.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/15.mp3"},{"answer":"It goes inside the turkey.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/16.mp3"},{"answer":"We put on nice clothes.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/17.mp3"},{"answer":"I set the table.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/18.mp3"},{"answer":"My dad carves the turkey.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/19.mp3"},{"answer":"My mom makes the gravy.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/20.mp3"},{"answer":"Our relatives arrive.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/21.mp3"},{"answer":"We say \"thank you\" for all we have.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/22.mp3"},{"answer":"We eat and eat.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/23.mp3"},{"answer":"It is a good Thanksgiving.","audio":"https://dailydictation.com/upload/general-english/17-thanksgiving-2019-03-20-05-37-29/24.mp3"}]
