[{"answer":"Every family that I know has at least one car.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/1.mp3"},{"answer":"Some families have two, or even three cars.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/2.mp3"},{"answer":"Most people get their licence to drive when they are sixteen.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/3.mp3"},{"answer":"In my house, we just have one car.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/4.mp3"},{"answer":"If my father takes the car to work, my mother will take the bus.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/5.mp3"},{"answer":"I ride in a school bus to school.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/6.mp3"},{"answer":"My sister works in another town.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/7.mp3"},{"answer":"She gets on the train to go to work.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/8.mp3"},{"answer":"The train station is not far from my house.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/9.mp3"},{"answer":"The train tracks run right by my house.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/10.mp3"},{"answer":"My grandfather from Ireland comes to visit us.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/11.mp3"},{"answer":"He came over by boat.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/12.mp3"},{"answer":"He had to cross the ocean.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/13.mp3"},{"answer":"We went to Florida last year.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/14.mp3"},{"answer":"We flew on a plane.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/15.mp3"},{"answer":"The plane flew right through the clouds.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/16.mp3"},{"answer":"My friend's brother drives a motorcycle.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/17.mp3"},{"answer":"He wears a helmet.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/18.mp3"},{"answer":"I rode on his motorcycle once.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/19.mp3"},{"answer":"I had to sit on the back and hold on tight.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/20.mp3"},{"answer":"I ride my bicycle when the weather is nice.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/21.mp3"},{"answer":"I also have a scooter that I use to travel around.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/22.mp3"},{"answer":"I took a helicopter ride once.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/23.mp3"},{"answer":"The helicopter's propellers were going around when I got on.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/24.mp3"},{"answer":"I went straight up in the air.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/25.mp3"},{"answer":"I enjoyed the ride.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/26.mp3"},{"answer":"I would like to learn how to fly a plane or a helicopter.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/27.mp3"},{"answer":"I like flying through the air.","audio":"https://dailydictation.com/upload/general-english/35-transportation-2019-03-20-09-34-00/28.mp3"}]
