[{"answer":"Is there a bakery near here?","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/1.mp3"},{"answer":"Yes, you can get there in five minutes.","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/2.mp3"},{"answer":"That's good. I don't have much time.","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/3.mp3"},{"answer":"Why are you going to the bakery?","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/4.mp3"},{"answer":"To buy a birthday cake.","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/5.mp3"},{"answer":"Whose birthday is it?","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/6.mp3"},{"answer":"My daughter's. She's ten.","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/7.mp3"},{"answer":"That's nice. Will you get some bread for me?","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/8.mp3"},{"answer":"Sure, do you want anything else?","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/9.mp3"},{"answer":"No, thanks. I'll pay you when you get back.","audio":"https://dailydictation.com/upload/english-conversations/77-will-you-get-some-bread-for-me-2022-03-07-21-29-47/10.mp3"}]
