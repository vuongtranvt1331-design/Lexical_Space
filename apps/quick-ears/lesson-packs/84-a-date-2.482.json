[{"answer":"Hello?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/1.mp3"},{"answer":"Sandy? Is that you?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/2.mp3"},{"answer":"Yes, uh-huh. Who's this?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/3.mp3"},{"answer":"It's Gill.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/4.mp3"},{"answer":"Gill? Gill who?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/5.mp3"},{"answer":"What do you mean, \"Gill who?\" Gill Dixon, of course.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/6.mp3"},{"answer":"Oh, Gill, I'm sorry.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/7.mp3"},{"answer":"Yes. We had a date last night.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/8.mp3"},{"answer":"Where were you? I waited for one hour.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/9.mp3"},{"answer":"Oh, I'm sorry, Gill. I couldn't come.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/10.mp3"},{"answer":"Couldn't come! Why not?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/11.mp3"},{"answer":"Well, I had to pack my stuff for my trip.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/12.mp3"},{"answer":"Why didn't you call me?","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/13.mp3"},{"answer":"I wanted to call you, but... uh... I couldn't remember your phone number.","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/14.mp3"},{"answer":"And now I'm going to forget yours!","audio":"https://dailydictation.com/upload/english-conversations/84-a-date-2-2022-03-07-21-32-13/15.mp3"}]
