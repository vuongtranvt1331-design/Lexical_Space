[{"answer":"Hi, how are you?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/1.mp3"},{"answer":"You look tired.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/2.mp3"},{"answer":"Did you sleep okay last night?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/3.mp3"},{"answer":"No, I didn't.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/4.mp3"},{"answer":"Why? What did you do yesterday?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/5.mp3"},{"answer":"I went to a nightclub last night and danced all night.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/6.mp3"},{"answer":"Oh, yeah? Did you have a good time?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/7.mp3"},{"answer":"I had a wonderful time, but I'm beat today.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/8.mp3"},{"answer":"What time did you leave the nightclub?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/9.mp3"},{"answer":"I left at about 3:00 a.m.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/10.mp3"},{"answer":"I'm not surprised that you're tired.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/11.mp3"},{"answer":"Which nightclub did you go to?","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/12.mp3"},{"answer":"Fantastic. It's on Ontario Street. It's really nice.","audio":"https://dailydictation.com/upload/english-conversations/24-what-did-you-do-yesterday-2022-03-07-21-12-15/13.mp3"}]
