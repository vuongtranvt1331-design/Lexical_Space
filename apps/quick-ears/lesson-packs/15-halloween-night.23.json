[{"answer":"Halloween is fun.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/1.mp3"},{"answer":"My mom buys candy.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/2.mp3"},{"answer":"My mom buys potato chips.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/3.mp3"},{"answer":"My mom buys chocolate bars.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/4.mp3"},{"answer":"It is for the trick-or-treaters.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/5.mp3"},{"answer":"My mom buys me a costume.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/6.mp3"},{"answer":"It is a ghost costume.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/7.mp3"},{"answer":"I am going to be scary.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/8.mp3"},{"answer":"My sister is going to dress up as a princess.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/9.mp3"},{"answer":"She will have a wand.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/10.mp3"},{"answer":"She will have a crown.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/11.mp3"},{"answer":"She will look beautiful.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/12.mp3"},{"answer":"My dad buys a pumpkin.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/13.mp3"},{"answer":"It is going to be a Jack O'Lantern.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/14.mp3"},{"answer":"We draw a face on the pumpkin.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/15.mp3"},{"answer":"We carve the face with a knife.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/16.mp3"},{"answer":"Our Jack O'Lantern looks funny.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/17.mp3"},{"answer":"We go trick-or-treating.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/18.mp3"},{"answer":"We knock on the neighbor's door.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/19.mp3"},{"answer":"We say, \"trick or treat\".","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/20.mp3"},{"answer":"Our neighbors give us candy.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/21.mp3"},{"answer":"We say \"Thanks\".","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/22.mp3"},{"answer":"We go to many houses.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/23.mp3"},{"answer":"We go home.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/24.mp3"},{"answer":"Our parents check our candy.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/25.mp3"},{"answer":"It's safe.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/26.mp3"},{"answer":"We eat lots of candy.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/27.mp3"},{"answer":"We don't feel very good.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/28.mp3"},{"answer":"We go to bed.","audio":"https://dailydictation.com/upload/general-english/15-halloween-night-2019-03-20-04-55-19/29.mp3"}]
