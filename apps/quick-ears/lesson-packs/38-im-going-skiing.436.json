[{"answer":"We got ten inches of snow.","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/1.mp3"},{"answer":"Wow! That's terrific!","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/2.mp3"},{"answer":"What's so terrific about it?","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/3.mp3"},{"answer":"I'm going skiing.","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/4.mp3"},{"answer":"Skiing? Are you serious?","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/5.mp3"},{"answer":"Yes. It's a lot of fun.","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/6.mp3"},{"answer":"Maybe, but it's also dangerous.","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/7.mp3"},{"answer":"You need to live on the edge!","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/8-2022-03-08-19-52-09.mp3"},{"answer":"And you need to make sure you don't fall off of it!","audio":"https://dailydictation.com/upload/english-conversations/39-im-going-skiing-2022-03-07-21-17-39/9.mp3"}]
