[{"answer":"Well, here's the kitchen.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/1.mp3"},{"answer":"Hmm... It's very small.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/2.mp3"},{"answer":"Yes, it isn't very large, but there's a cooker and a fridge.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/3.mp3"},{"answer":"There are some cupboards under the sink.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/4.mp3"},{"answer":"Are there any plates?","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/5.mp3"},{"answer":"Yes, there are.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/6.mp3"},{"answer":"Good. Are there any chairs in here?","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/7.mp3"},{"answer":"No, there aren't, but there are some in the living room.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/8.mp3"},{"answer":"Hmm. There aren't any glasses!","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/9.mp3"},{"answer":"Yes, there are! They're in the cupboard.","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/10.mp3"},{"answer":"and... er... where's the toilet?","audio":"https://dailydictation.com/upload/english-conversations/60-a-nice-flat-2-2022-03-07-21-24-54/11.mp3"}]
