[{"answer":"Let's go for a picnic.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/1.mp3"},{"answer":"That's a great idea! Where shall we go?","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/2.mp3"},{"answer":"Let's go to the park.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/3.mp3"},{"answer":"How far is it?","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/4.mp3"},{"answer":"About a mile.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/5.mp3"},{"answer":"Is it a nice place?","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/6.mp3"},{"answer":"Sure. It has picnic tables and a beautiful lake.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/7.mp3"},{"answer":"Good. I'll make some sandwiches.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/8.mp3"},{"answer":"I'll bring soda and cookies.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/9.mp3"},{"answer":"The kids will love it.","audio":"https://dailydictation.com/upload/english-conversations/37-a-picnic-2022-03-08-16-53-08/10.mp3"}]
