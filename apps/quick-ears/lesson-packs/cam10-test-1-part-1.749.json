[{"answer":"Good morning. World Tours.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/1.mp3"},{"answer":"My name is Jamie.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/2.mp3"},{"answer":"How can I help you?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/3.mp3"},{"answer":"Good morning.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/4.mp3"},{"answer":"I want some information on self-drive tours in the USA.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/5.mp3"},{"answer":"Could you send me a brochure?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/6.mp3"},{"answer":"Of course.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/7.mp3"},{"answer":"Could I have your name please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/8.mp3"},{"answer":"Andrea Brown.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/9.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/10.mp3"},{"answer":"And your address?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/11.mp3"},{"answer":"24, Ardleigh Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/12.mp3"},{"answer":"Can you spell that?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/13.mp3"},{"answer":"A-R-D-L-E-I-G-H Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/14.mp3"},{"answer":"Postcode?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/15.mp3"},{"answer":"BH52OP","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/16.mp3"},{"answer":"Thanks.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/17.mp3"},{"answer":"And can I have your phone number?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/18.mp3"},{"answer":"Is a mobile alright?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/19.mp3"},{"answer":"Fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/20.mp3"},{"answer":"It's 07786643091.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/21.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/22.mp3"},{"answer":"And can I ask you where you heard about World Tours?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/23.mp3"},{"answer":"From a friend? Or did you see an advert somewhere?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/24.mp3"},{"answer":"No, I read about you in the newspaper.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/25.mp3"},{"answer":"OK, I'll get the brochures in the post to you but can I give you some information over the phone.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/26.mp3"},{"answer":"What kinds of things do you want to do on your holiday?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/27.mp3"},{"answer":"I'm interested in going to California with my family.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/28.mp3"},{"answer":"I've got two children and we want to hire a car.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/29.mp3"},{"answer":"OK.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/30.mp3"},{"answer":"We have a couple of self-drive tours there visiting different places of interest in California.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/31.mp3"},{"answer":"The first one begins in Los Angeles and there's plenty of time to visit some of the theme parks there.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/32.mp3"},{"answer":"That's something on my children's list so I'd want to include that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/33.mp3"},{"answer":"Good. Then you drive to San Francisco.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/34.mp3"},{"answer":"From San Francisco you can drive to Yosemite Park where you spend a couple of nights.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/35.mp3"},{"answer":"You can choose to stay in a lodge or on the campsite.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/36.mp3"},{"answer":"I don't like the idea of staying in a tent.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/37.mp3"},{"answer":"It'd be too hot.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/38.mp3"},{"answer":"Right.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/39.mp3"},{"answer":"And the tour ends in Las Vegas.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/40.mp3"},{"answer":"OK.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/41.mp3"},{"answer":"The other trip we can arrange is slightly different.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/42.mp3"},{"answer":"It starts in San Francisco.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/43.mp3"},{"answer":"Then you drive south to Cambria.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/44.mp3"},{"answer":"Someone told me there's a really nice castle near Cambria.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/45.mp3"},{"answer":"Will we go near that?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/46.mp3"},{"answer":"Hearst Castle is on that road so you could stop there.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/47.mp3"},{"answer":"Good. I'd like to do that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/48.mp3"},{"answer":"Does this trip also go into the desert?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/49.mp3"},{"answer":"No, it continues to Santa Monica where most people like to stop and do some shopping.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/50.mp3"},{"answer":"We have enough of that at home so that doesn't interest us.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/51.mp3"},{"answer":"OK. Well you could go straight on to San Diego.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/52.mp3"},{"answer":"That's good for beaches isn't it?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/53.mp3"},{"answer":"That's right, that's a good place to relax and your children might like to visit the zoo before flying home.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/54.mp3"},{"answer":"I don't think so.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/55.mp3"},{"answer":"We want some time for sunbathing and swimming.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/56.mp3"},{"answer":"So how many days are the trips and how much do they cost?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/57.mp3"},{"answer":"The first one I told you about is a self-drive tour through California","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/58.mp3"},{"answer":"which lasts twelve days and covers 2,020 kilometres.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/59.mp3"},{"answer":"The shortest journey is 206 kilometres","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/60.mp3"},{"answer":"and the longest is 632 kilometres.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/61.mp3"},{"answer":"The cost is £525 per person.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/62.mp3"},{"answer":"That includes accommodation, car rental and a flight but no meals.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/63.mp3"},{"answer":"OK. And the other trip?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/64.mp3"},{"answer":"That lasts nine days but you spend only three days on the road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/65.mp3"},{"answer":"You cover about 980 kilometres altogether.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/66.mp3"},{"answer":"So is that cheaper then?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/67.mp3"},{"answer":"Yes, it's almost a hundred pounds cheaper.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/68.mp3"},{"answer":"It's £429 per person, which is a good deal.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/69.mp3"},{"answer":"So that covers accommodation and car hire.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/70.mp3"},{"answer":"What about flights?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/71.mp3"},{"answer":"They aren't included.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/72.mp3"},{"answer":"But these hotels offer dinner in the price.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/73.mp3"},{"answer":"OK. Well, thank you very much.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/74.mp3"},{"answer":"I'll be in touch when I've had a chance to look at the brochure.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/75.mp3"},{"answer":"I'm pleased to help.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/76.mp3"},{"answer":"Goodbye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/77.mp3"},{"answer":"Goodbye.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-10-test-1-part-1-2023-06-09-21-53-29/78.mp3"}]
