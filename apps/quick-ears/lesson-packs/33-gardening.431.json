[{"answer":"Your garden is really lovely.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/1.mp3"},{"answer":"Thank you. I enjoy working in the garden.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/2.mp3"},{"answer":"Do you do everything yourself?","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/3.mp3"},{"answer":"I trim the bushes and weed the flowerbeds myself.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/4.mp3"},{"answer":"Who cuts the grass?","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/5.mp3"},{"answer":"Oh, it's so big that I hire one of the boys in the neighbourhood to do it for me.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/6.mp3"},{"answer":"Well, I must say he does a good job.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/7.mp3"},{"answer":"Yes. His work is more than satisfactory.","audio":"https://dailydictation.com/upload/english-conversations/33-gardening-2022-03-07-21-14-59/8.mp3"}]
