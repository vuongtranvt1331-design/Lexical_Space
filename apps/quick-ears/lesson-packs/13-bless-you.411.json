[{"answer":"Ah-choo!","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/1.mp3"},{"answer":"God bless you!","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/2.mp3"},{"answer":"Thank you.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/3.mp3"},{"answer":"You have a cold?","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/4.mp3"},{"answer":"Yes, that's why I'm sneezing so much.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/5.mp3"},{"answer":"I hope you feel better soon.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/6.mp3"},{"answer":"I get a bad cold every winter.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/7.mp3"},{"answer":"Are you taking anything for your cold?","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/8.mp3"},{"answer":"I'm taking Contac.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/9.mp3"},{"answer":"Does it help?","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/10.mp3"},{"answer":"Yes, but it makes me sleepy.","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/11.mp3"},{"answer":"You'd better not drive then!","audio":"https://dailydictation.com/upload/english-conversations/13-bless-you-2022-03-07-21-07-14/12.mp3"}]
