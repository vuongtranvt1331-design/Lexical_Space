[{"answer":"Today is my cousin's birthday.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/1.mp3"},{"answer":"What's your cousin's name?","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/2.mp3"},{"answer":"Kathy. I'm going to her house after dinner.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/3.mp3"},{"answer":"How old is she?","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/4.mp3"},{"answer":"She's 24","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/5.mp3"},{"answer":"Hmm. She's my age.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/6.mp3"},{"answer":"Is she pretty?","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/7.mp3"},{"answer":"Yes, and she's very nice, too.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/8.mp3"},{"answer":"Is she single?","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/9.mp3"},{"answer":"No, she's married and has two children.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/10.mp3"},{"answer":"Oh that's too bad.","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/11.mp3"},{"answer":"Not for her!","audio":"https://dailydictation.com/upload/english-conversations/55-is-she-single-2022-03-07-21-23-01/12.mp3"}]
