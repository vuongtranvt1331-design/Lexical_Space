[{"answer":"Good morning. Can I see your passport?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/1.mp3"},{"answer":"Certainly. Here it is.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/2.mp3"},{"answer":"Yes, that's all right. Have you got anything to declare?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/3.mp3"},{"answer":"Yes, I have. I've got some whisky and some cigarettes.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/4.mp3"},{"answer":"How much whisky have you got?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/5.mp3"},{"answer":"A litre.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/6.mp3"},{"answer":"That's all right. And how many cigarettes have you got?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/7.mp3"},{"answer":"200.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/8.mp3"},{"answer":"Fine. What about perfume?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/9.mp3"},{"answer":"Er... No, I haven't.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/10.mp3"},{"answer":"Good. Open your case, please.","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/11.mp3"},{"answer":"Pardon?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/12.mp3"},{"answer":"Open your case, please. Open it now!","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/13.mp3"},{"answer":"Oh, dear! Look at this!","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/14.mp3"},{"answer":"You've got 3 bottles of whisky, 400 cigarettes and a lot of perfume!","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/15.mp3"},{"answer":"Does that mean I can't go?","audio":"https://dailydictation.com/upload/english-conversations/26-at-the-customs-2022-03-07-21-13-03/16.mp3"}]
