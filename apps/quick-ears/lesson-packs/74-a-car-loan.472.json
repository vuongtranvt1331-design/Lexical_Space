[{"answer":"I want to go to the bank this afternoon.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/1.mp3"},{"answer":"I'll drive you there.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/2.mp3"},{"answer":"Thanks. I'm going to apply for a loan.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/3.mp3"},{"answer":"Why do you need a loan?","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/4.mp3"},{"answer":"I have to buy a new car.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/5.mp3"},{"answer":"What's wrong with your car?","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/6.mp3"},{"answer":"It won't start, and it's ten years old.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/7.mp3"},{"answer":"How much will a new car cost?","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/8.mp3"},{"answer":"About $15,000.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/9.mp3"},{"answer":"Wow! That's a lot of money.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/10.mp3"},{"answer":"I know. That's why I need a loan.","audio":"https://dailydictation.com/upload/english-conversations/74-a-car-loan-2022-03-07-21-28-51/11.mp3"}]
