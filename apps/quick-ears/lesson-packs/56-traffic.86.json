[{"answer":"Traffic moves along on the streets and highways.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/1.mp3"},{"answer":"There are rules that drivers must follow to make the traffic flow smoothly.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/2.mp3"},{"answer":"You must wear a seatbelt.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/3.mp3"},{"answer":"The seatbelt helps to keep you safe.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/4.mp3"},{"answer":"You must stop at all stop signs.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/5.mp3"},{"answer":"You must also stop at a red light.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/6.mp3"},{"answer":"A green light means go,","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/7.mp3"},{"answer":"and a yellow light means to be careful.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/8.mp3"},{"answer":"If you see a sign that says school crossing,","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/9.mp3"},{"answer":"you have to be careful because you are near a school,","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/10.mp3"},{"answer":"and children might be crossing the street.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/11.mp3"},{"answer":"Some places are crosswalks.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/12.mp3"},{"answer":"Those are places where people cross the street.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/13.mp3"},{"answer":"People who are walking have the right of way.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/14.mp3"},{"answer":"If you hear a siren behind you, you must pull over.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/15.mp3"},{"answer":"An emergency vehicle like a police car or an ambulance might need to get somewhere fast.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/16.mp3"},{"answer":"When a school bus puts on its flashing signals, you have to stop.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/17.mp3"},{"answer":"You can't go past the school bus because children may be crossing the street from the bus.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/18.mp3"},{"answer":"You should always obey the speed limit.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/19.mp3"},{"answer":"It is not good to drive too fast.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/20.mp3"},{"answer":"People should never drink and drive.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/21.mp3"},{"answer":"Driving is a serious business.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/22.mp3"},{"answer":"You have to obey all the rules to be a good driver.","audio":"https://dailydictation.com/upload/general-english/56-traffic-2019-03-29-10-24-33/23.mp3"}]
