[{"answer":"I have some good news.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/1.mp3"},{"answer":"What is it?","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/2.mp3"},{"answer":"Lisa is going to have a baby.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/3.mp3"},{"answer":"That's great! I'm so happy for her.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/4.mp3"},{"answer":"Me too!","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/5.mp3"},{"answer":"Do they want a boy or a girl?","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/6.mp3"},{"answer":"A girl.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/7.mp3"},{"answer":"When's the baby due?","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/8.mp3"},{"answer":"In the beginning of September.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/9.mp3"},{"answer":"I'm gonna phone Lisa tonight.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/10.mp3"},{"answer":"That's nice. Say hello for me.","audio":"https://dailydictation.com/upload/english-conversations/31-whens-the-baby-due-2022-03-07-21-14-19/11.mp3"}]
