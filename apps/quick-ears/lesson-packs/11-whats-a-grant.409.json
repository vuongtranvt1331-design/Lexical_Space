[{"answer":"My daughter is going to college.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/1.mp3"},{"answer":"That's great, but it must be expensive.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/2.mp3"},{"answer":"Yes, but she has a grant.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/3.mp3"},{"answer":"A grant? What's a grant?","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/4.mp3"},{"answer":"The government is giving her money.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/5.mp3"},{"answer":"To pay for her education?","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/6.mp3"},{"answer":"That's right.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/7.mp3"},{"answer":"Does it pay for everything?","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/8.mp3"},{"answer":"No, she has a loan, too.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/9.mp3"},{"answer":"What's the difference between a loan and a grant?","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/10.mp3"},{"answer":"You have to pay back a loan; a grant is a gift.","audio":"https://dailydictation.com/upload/english-conversations/11-whats-a-grant-2022-03-07-20-54-47/11.mp3"}]
