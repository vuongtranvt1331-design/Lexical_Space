[{"answer":"This is a big menu.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/1.mp3"},{"answer":"Yeah, what are you getting?","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/2.mp3"},{"answer":"Chicken, peas, and baked potatoes.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/3.mp3"},{"answer":"I don't know what to get.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/4.mp3"},{"answer":"They have very good turkey.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/5.mp3"},{"answer":"I had turkey yesterday.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/6.mp3"},{"answer":"How about steak?","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/7.mp3"},{"answer":"Perfect. I'll get steak and mashed potatoes.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/8.mp3"},{"answer":"What vegetable are you getting?","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/9.mp3"},{"answer":"I'm not getting any. I don't like vegetables.","audio":"https://dailydictation.com/upload/english-conversations/30-at-the-restaurant-2022-03-07-21-14-05/10.mp3"}]
