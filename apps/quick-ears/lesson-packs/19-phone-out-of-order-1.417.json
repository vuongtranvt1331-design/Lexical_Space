[{"answer":"Hey! Hey!","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/1.mp3"},{"answer":"What's wrong?","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/2.mp3"},{"answer":"There's something wrong with the phone. I'm getting a strange noise.","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/3.mp3"},{"answer":"Are you? I can hear you clearly.","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/4.mp3"},{"answer":"Hello! Hello!","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/5.mp3"},{"answer":"This pay phone might be out of order.","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/6.mp3"},{"answer":"I'll call you again with another phone....","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/7.mp3"},{"answer":"Hello! How about now? Is there still a strange noise?","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/8.mp3"},{"answer":"Yes. Perhaps my phone is out of order.","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/9.mp3"},{"answer":"You should get in touch with the phone company.","audio":"https://dailydictation.com/upload/english-conversations/19-phone-out-of-order-1-2022-03-07-21-10-46/10.mp3"}]
