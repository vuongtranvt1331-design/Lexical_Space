[{"answer":"I can't believe it's been almost five years since we last saw each other.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/1.mp3"},{"answer":"Yeah, it's crazy how time flies.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/2.mp3"},{"answer":"How have you been?","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/3.mp3"},{"answer":"I've been good! I just moved to a new city for work.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/4.mp3"},{"answer":"What about you?","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/5.mp3"},{"answer":"I've been busy with my job too, but I'm still in the same place.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/6.mp3"},{"answer":"Are you liking your new city?","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/7.mp3"},{"answer":"Yes, it's great!","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/8.mp3"},{"answer":"There's so much to explore.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/9.mp3"},{"answer":"I just miss some old friends.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/10.mp3"},{"answer":"We should catch up more often and not let so much time pass.","audio":"https://dailydictation.com/upload/toeic/conversation-meeting-an-old-friend-2024-07-21-17-26-12/11.mp3"}]
