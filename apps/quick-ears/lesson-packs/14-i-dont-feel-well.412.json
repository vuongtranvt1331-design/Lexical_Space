[{"answer":"What are you looking for?","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/1.mp3"},{"answer":"My jacket. I'm going to the doctor.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/2.mp3"},{"answer":"Why? What's the problem?","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/3.mp3"},{"answer":"I'm not sure, but I don't feel well.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/4-2024-01-09-18-14-28.mp3"},{"answer":"Do you have a fever?","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/5.mp3"},{"answer":"No, but I have a pain in my chest.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/6.mp3"},{"answer":"What time is your appointment?","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/7.mp3"},{"answer":"11:30 I'm going now. Bye.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/8.mp3"},{"answer":"Goodbye. I hope it's nothing serious.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/9.mp3"},{"answer":"Thanks. See you.","audio":"https://dailydictation.com/upload/english-conversations/14-i-dont-feel-well-2022-03-07-21-08-48/10.mp3"}]
