[{"answer":"My family is very musical.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/1.mp3"},{"answer":"My father plays the guitar.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/2.mp3"},{"answer":"He plays in a band.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/3.mp3"},{"answer":"The band plays country music.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/4.mp3"},{"answer":"My mother is a singer in the band.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/5.mp3"},{"answer":"She also plays the piano.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/6.mp3"},{"answer":"I took the flute in music class at school.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/7.mp3"},{"answer":"I play the flute in the school band.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/8.mp3"},{"answer":"I also sing in the school choir.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/9.mp3"},{"answer":"I have a low voice.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/10.mp3"},{"answer":"My sister has a high voice.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/11.mp3"},{"answer":"She is a soprano.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/12.mp3"},{"answer":"At home I like to practice the drums,","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/13.mp3"},{"answer":"but my mother says that it's too loud.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/14.mp3"},{"answer":"Sometimes I play so loudly that I break a drumstick.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/15.mp3"},{"answer":"I practice whenever she goes out.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/16.mp3"},{"answer":"I would like to be in a rock band.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/17.mp3"},{"answer":"Some of my friends and I are thinking of starting our own rock band.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/18.mp3"},{"answer":"My sister is a very good piano player.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/19.mp3"},{"answer":"She has won many awards at music festivals.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/20.mp3"},{"answer":"She likes to play classical music,","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/21.mp3"},{"answer":"but sometimes I get her to play rock music with me.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/22.mp3"},{"answer":"She is also a very good singer.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/23.mp3"},{"answer":"I like to sing with her.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/24.mp3"},{"answer":"We sing in harmony.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/25.mp3"},{"answer":"I listen to music all the time on the radio.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/26.mp3"},{"answer":"I know a lot of songs.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/27.mp3"},{"answer":"I can sing along with most of the songs that come on the radio.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/28.mp3"},{"answer":"I memorize the lyrics of the songs.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/29.mp3"},{"answer":"My sister and I sometimes get together and sing our favorite songs.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/30.mp3"},{"answer":"Maybe someday we will start our own rock band,","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/31.mp3"},{"answer":"and I will be the drummer.","audio":"https://dailydictation.com/upload/general-english/66-music-2-2019-03-29-12-43-25/32.mp3"}]
