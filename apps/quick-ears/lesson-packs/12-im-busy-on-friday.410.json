[{"answer":"Would you like to go to a pop concert?","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/1.mp3"},{"answer":"Well, I'd like to... but when is it?","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/2.mp3"},{"answer":"On Friday evening.","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/3.mp3"},{"answer":"What a pity! I'm busy on Friday.","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/4.mp3"},{"answer":"Maybe you could change your plans?","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/5.mp3"},{"answer":"It's gonna be a really great concert.","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/6.mp3"},{"answer":"Maybe I will, I wouldn't wanna miss it.","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/7.mp3"},{"answer":"Great, I'll see you Friday!","audio":"https://dailydictation.com/upload/english-conversations/12-im-busy-on-friday-2022-03-07-20-55-26/8.mp3"}]
