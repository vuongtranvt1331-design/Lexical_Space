[{"answer":"Do you have any pets at home?","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/1.mp3"},{"answer":"Yes, I have a dog and a cat.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/2.mp3"},{"answer":"They're both really friendly.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/3.mp3"},{"answer":"That sounds nice! What are their names?","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/4.mp3"},{"answer":"The dog's name is Max, and the cat's name is Whiskers.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/5.mp3"},{"answer":"Do you have any pets?","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/6.mp3"},{"answer":"Not right now, but I used to have a turtle named Tiny.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/7.mp3"},{"answer":"He was really cute.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/8.mp3"},{"answer":"Turtles are great!","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/9.mp3"},{"answer":"They don't need too much attention but are still fun to watch.","audio":"https://dailydictation.com/upload/toeic/conversation-1-talking-about-pets-2024-07-21-17-13-48/10.mp3"}]
