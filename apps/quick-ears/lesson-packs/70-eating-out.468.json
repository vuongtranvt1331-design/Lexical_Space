[{"answer":"Waiter! Could we have the bill, please?","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/1.mp3"},{"answer":"Can I put it all on one bill?","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/2.mp3"},{"answer":"No, we'd prefer separate checks.","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/3.mp3"},{"answer":"Your bill's $18.","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/4.mp3"},{"answer":"That seems expensive. Would you check it again please?","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/5.mp3"},{"answer":"Sorry, ma'am. This is your friend's bill.","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/6.mp3"},{"answer":"Here is yours; it's $24.16!","audio":"https://dailydictation.com/upload/english-conversations/70-eating-out-2022-03-07-21-27-45/7.mp3"}]
