[{"answer":"I wake up every morning at seven o'clock.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/1.mp3"},{"answer":"I take a shower.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/2.mp3"},{"answer":"I eat my breakfast.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/3.mp3"},{"answer":"I usually have toast or cereal.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/4.mp3"},{"answer":"I brush my teeth.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/5.mp3"},{"answer":"I put on my clothes.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/6.mp3"},{"answer":"I catch the school bus.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/7.mp3"},{"answer":"I ride to school.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/8.mp3"},{"answer":"In my class, we have math and English before recess.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/9.mp3"},{"answer":"At recess time, the girls skip, or walk around and talk.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/10.mp3"},{"answer":"The boys play in the playground or play baseball.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/11.mp3"},{"answer":"After recess, we have physical education and geography.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/13-2023-06-04-10-10-23.mp3"},{"answer":"We eat lunch, and then we play outside.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/14.mp3"},{"answer":"When the bell rings, we line up to go back into the classroom.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/15.mp3"},{"answer":"After lunch, we have history and science.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/16.mp3"},{"answer":"At recess, we play ball again.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/17.mp3"},{"answer":"Some of the girls play ball too.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/18.mp3"},{"answer":"In the winter, we build snowmen.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/19.mp3"},{"answer":"If it is too cold, we stay indoors and talk to each other.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/20.mp3"},{"answer":"After recess, we have music and health.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/21.mp3"},{"answer":"We get out of school at 3:30.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/22.mp3"},{"answer":"I sometimes walk home with my friends, or I take the bus.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/23.mp3"},{"answer":"I have a snack and change my clothes when I get home.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/24.mp3"},{"answer":"If it is raining, I watch television.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/25.mp3"},{"answer":"If it is nice outside, I play with my friends.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/26.mp3"},{"answer":"I have supper at 5:30.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/27.mp3"},{"answer":"On some nights, I help my mother to do the dishes.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/27-2024-07-27-16-49-18.mp3"},{"answer":"After supper, I do my homework.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/29.mp3"},{"answer":"I wash my face and hands, and brush my teeth.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/30.mp3"},{"answer":"I change into my pyjamas.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/31.mp3"},{"answer":"I go to bed at 9 o'clock.","audio":"https://dailydictation.com/upload/general-english/21-daily-schedule-2019-03-20-08-42-31/32.mp3"}]
