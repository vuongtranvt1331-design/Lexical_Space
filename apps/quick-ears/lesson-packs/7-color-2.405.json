[{"answer":"Excuse me? Is this your umbrella?","audio":"https://dailydictation.com/upload/english-conversations/7-color-2-2022-03-07-20-52-43/1.mp3"},{"answer":"No, it isn't.","audio":"https://dailydictation.com/upload/english-conversations/7-color-2-2022-03-07-20-52-43/2.mp3"},{"answer":"Are you sure?","audio":"https://dailydictation.com/upload/english-conversations/7-color-2-2022-03-07-20-52-43/3.mp3"},{"answer":"Yes, I am sure.","audio":"https://dailydictation.com/upload/english-conversations/7-color-2-2022-03-07-20-52-43/4.mp3"},{"answer":"That umbrella is brown, and my umbrella is yellow.","audio":"https://dailydictation.com/upload/english-conversations/7-color-2-2022-03-07-20-52-43/5.mp3"}]
