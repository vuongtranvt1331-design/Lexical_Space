[{"answer":"There are twelve months in the year.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/1.mp3"},{"answer":"January is the first month of the year.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/2.mp3"},{"answer":"It is usually cold in January.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/3.mp3"},{"answer":"February is the second month of the year.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/4.mp3"},{"answer":"It is still winter when February comes.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/5.mp3"},{"answer":"They say that March comes in like a lion and goes out like a lamb.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/6.mp3"},{"answer":"That means that it is still usually cold, and sometimes stormy when March begins.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/7.mp3"},{"answer":"By the time that March ends, the weather is starting to get a little better.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/8.mp3"},{"answer":"April is the rainy month.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/9.mp3"},{"answer":"April showers bring May flowers.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/10.mp3"},{"answer":"Many of the spring flowers bloom in May.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/11.mp3"},{"answer":"The weather can be quite mild in May.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/12.mp3"},{"answer":"June is usually a nice warm month.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/13.mp3"},{"answer":"Many people get married in June.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/14.mp3"},{"answer":"July can be hot. People have vacations in July.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/15.mp3"},{"answer":"It is a month to do summer things.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/16.mp3"},{"answer":"It is still summer in August, but the summer is winding down.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/17.mp3"},{"answer":"August is the time to have last minute vacations.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/18.mp3"},{"answer":"In September, we go back to school.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/19.mp3"},{"answer":"The autumn winds begin to blow.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/20.mp3"},{"answer":"October really feels like autumn.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/21.mp3"},{"answer":"October is Halloween time.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/22.mp3"},{"answer":"November is when we really start to feel the chill.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/23.mp3"},{"answer":"December is the Christmas month.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/24.mp3"},{"answer":"Most people do a lot of Christmas shopping in December.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/25.mp3"},{"answer":"They spend quite a bit of time getting ready for Christmas.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/26.mp3"},{"answer":"All of the months are different.","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/27.mp3"},{"answer":"Which month were you born in?","audio":"https://dailydictation.com/upload/general-english/43-months-2019-03-29-10-16-23/28.mp3"}]
