[{"answer":"Good evening. King's Restaurant.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/1.mp3"},{"answer":"Good evening.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/2.mp3"},{"answer":"I'm ringing about the job I understand you have vacant.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/3.mp3"},{"answer":"Oh yes.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/4.mp3"},{"answer":"I'd like to find out a few more details, if i may.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/5.mp3"},{"answer":"Yes, of course. Can i take your name?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/6.mp3"},{"answer":"It's Peter Chin.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/7.mp3"},{"answer":"Okay Peter.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/8.mp3"},{"answer":"Well, if you want to ask about the job and then if we're both still interested,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/9.mp3"},{"answer":"we could arrange for you to come for an interview.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/10.mp3"},{"answer":"Great, thanks.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/11.mp3"},{"answer":"I'm afraid i missed the advert for the job but heard about it from a friend.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/12.mp3"},{"answer":"That's no problem at all.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/13.mp3"},{"answer":"What would you like to know?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/14.mp3"},{"answer":"Well, um, what sort of work is it? Washing up?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/15.mp3"},{"answer":"It's answering the phone.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/16.mp3"},{"answer":"Oh, right, fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/17.mp3"},{"answer":"And not waiting at table.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/18.mp3"},{"answer":"That'd be good.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/19.mp3"},{"answer":"And how many nights a week would it be?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/20.mp3"},{"answer":"Well, we're really only busy at the weekend.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/21.mp3"},{"answer":"So two nights?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/22.mp3"},{"answer":"Three actually, so it would work out at twelve hours a week.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/23.mp3"},{"answer":"That'd be fine.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/24.mp3"},{"answer":"It wouldn't interfere with my studies.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/25.mp3"},{"answer":"Are you at the university?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/26.mp3"},{"answer":"Yes. First year Physics student.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/27.mp3"},{"answer":"Oh right.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/28.mp3"},{"answer":"Um, and because I'm not an EU national, would I need a work permit?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/29.mp3"},{"answer":"Yes you would.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/30.mp3"},{"answer":"Just get your tutor to sign it.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/31.mp3"},{"answer":"That wouldn't be a problem, if i were to get the job.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/32.mp3"},{"answer":"Um, where exactly is the restaurant?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/33.mp3"},{"answer":"Well, we have two branches -","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/34.mp3"},{"answer":"the one we're recruiting for is in Hillsdunne Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/35.mp3"},{"answer":"I don't know that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/36.mp3"},{"answer":"How do you spell it please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/37.mp3"},{"answer":"It's HILLSDUNNE Road.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/38.mp3"},{"answer":"Got that. Thanks.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/39.mp3"},{"answer":"is it near a bus stop?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/40.mp3"},{"answer":"Yes. The nearest one would probably be just beside the library.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/41.mp3"},{"answer":"Oh yes, I know it. That'd be fine for me.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/42.mp3"},{"answer":"And could I ask about the pay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/43.mp3"},{"answer":"We're offering £4.45 an hour.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/44.mp3"},{"answer":"That's very good.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/45.mp3"},{"answer":"My last job was £3.95 an hour.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/46.mp3"},{"answer":"We feel it's pretty good and we also offer some good fringe benefits.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/47.mp3"},{"answer":"Really?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/48.mp3"},{"answer":"Well, we give you a free dinner, so you eat well.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/49.mp3"},{"answer":"Right, better than hostel food!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/50.mp3"},{"answer":"We certainly hope so!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/51.mp3"},{"answer":"And we also offer extra pay for working on national holidays.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/52.mp3"},{"answer":"Oh, that's a really good perk, isn't it?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/53.mp3"},{"answer":"Yes, we think so.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/54.mp3"},{"answer":"And then because of the difficulties of getting public transport,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/55.mp3"},{"answer":"if you're working after 11 o'clock we drive you home.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/56.mp3"},{"answer":"Oh, that's good to know.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/57.mp3"},{"answer":"Well, we'd certainly be interested in inviting you for an interview, if you're still interested?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/58.mp3"},{"answer":"Oh yes, certainly.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/59.mp3"},{"answer":"Could I just also ask what qualities you're looking for?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/60.mp3"},{"answer":"Well, for this particular job we want a clear voice, which you obviously do have!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/61.mp3"},{"answer":"Thanks.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/62.mp3"},{"answer":"And you must be able to think quickly, you know.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/63.mp3"},{"answer":"Well, I hope I'd...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/64.mp3"},{"answer":"So, when could you come in for an interview?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/65.mp3"},{"answer":"We're actually quite quiet tonight?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/66.mp3"},{"answer":"Sorry, I couldn't come tonight...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/67.mp3"},{"answer":"or tomorrow, I'm afraid.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/68.mp3"},{"answer":"Thursday's okay, that'd be 22nd of October.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/69.mp3"},{"answer":"Fine, after 5 p.m?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/70.mp3"},{"answer":"Yes, fine. Would 6 o'clock be okay?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/71.mp3"},{"answer":"Perfect.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/72.mp3"},{"answer":"And could you bring along the names of two referees?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/73.mp3"},{"answer":"Yes, that's fine, no problem.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/74.mp3"},{"answer":"Good, I look forward to seeing you.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/75.mp3"},{"answer":"Oh, by the way, who should i ask for?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/76.mp3"},{"answer":"Oh yes, of course, sorry.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/77.mp3"},{"answer":"My name is Samira Manuja.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/78.mp3"},{"answer":"Can you spell that, please?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/79.mp3"},{"answer":"MANUJA.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/80.mp3"},{"answer":"Okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/81.mp3"},{"answer":"I've got that. Thanks very much.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/82.mp3"},{"answer":"Look forward to seeing you later on then.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-9-test-1-part-1-2023-07-22-18-07-21/83.mp3"}]
