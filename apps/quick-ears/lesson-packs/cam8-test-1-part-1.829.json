[{"answer":"Hi, George!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/1.mp3"},{"answer":"Glad you're back.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/2.mp3"},{"answer":"Loads of people have phoned you.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/3.mp3"},{"answer":"Really?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/4.mp3"},{"answer":"I felt just like your secretary!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/5.mp3"},{"answer":"Sorry!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/6.mp3"},{"answer":"I went into the library this afternoon to have a look at a newspaper and I came across something really interesting.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/7.mp3"},{"answer":"What? A book?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/8.mp3"},{"answer":"No, a brochure from a summer festival - mainly Spanish music.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/9.mp3"},{"answer":"Look, I've got it here.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/10.mp3"},{"answer":"Spanish music?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/11.mp3"},{"answer":"I really love the guitar.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/12.mp3"},{"answer":"Let's have a look.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/13.mp3"},{"answer":"So what's this group 'Guitarrini'?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/14.mp3"},{"answer":"They're really good.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/15.mp3"},{"answer":"They had a video with all the highlights of the festival at a stand in the lobby to the library,","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/16.mp3"},{"answer":"so I heard them.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/17.mp3"},{"answer":"They play fantastic instruments - drums and flutes and old kinds of guitars.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/18.mp3"},{"answer":"I've never heard anything like it before.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/19.mp3"},{"answer":"Sounds great.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/20.mp3"},{"answer":"Okay. Shall we go then?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/21.mp3"},{"answer":"Spoil ourselves?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/22.mp3"},{"answer":"Yes, let's.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/23.mp3"},{"answer":"The only problem is there aren't any cheap seats...","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/24.mp3"},{"answer":"it's all one price.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/25.mp3"},{"answer":"Well, in that case we could sit right at the front -","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/26.mp3"},{"answer":"we'd have a really good view.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/27.mp3"},{"answer":"Yeah, though I think that if you sit at the back you can actually hear the whole thing better.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/28.mp3"},{"answer":"Yes, anyway we can decide when we get there.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/29.mp3"},{"answer":"So will you fill in the form or shall I?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/30.mp3"},{"answer":"I'll do it.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/31.mp3"},{"answer":"Name: George O'Neill.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/32.mp3"},{"answer":"Address:","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/33.mp3"},{"answer":"48 North Avenue, Westsea.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/34.mp3"},{"answer":"Do you remember our new postcode?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/35.mp3"},{"answer":"Still can't remember it.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/36.mp3"},{"answer":"Just a minute, I've got it written down here.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/37.mp3"},{"answer":"WS62YH","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/38.mp3"},{"answer":"Do you need the phone too?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/39.mp3"},{"answer":"Please.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/40.mp3"},{"answer":"I'm really bad at numbers.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/41.mp3"},{"answer":"01674553242.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/42.mp3"},{"answer":"So, let's book two tickets for Guitarrini.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/43.mp3"},{"answer":"Okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/44.mp3"},{"answer":"If you're sure 7.50 each is alright.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/45.mp3"},{"answer":"How do you feel about the singer?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/46.mp3"},{"answer":"I haven't quite decided.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/47.mp3"},{"answer":"But I've noticed something on the booking form that might just persuade me!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/48.mp3"},{"answer":"What's that then?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/49.mp3"},{"answer":"Free refreshments!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/50.mp3"},{"answer":"Really?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/51.mp3"},{"answer":"Yes, look here.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/52.mp3"},{"answer":"Sunday 17th of June.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/53.mp3"},{"answer":"Singer, ticket £6 includes drinks in the garden.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/54.mp3"},{"answer":"Sounds like a bargain to me!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/55.mp3"},{"answer":"Yes, let's book two tickets for that.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/56.mp3"},{"answer":"So, what else?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/57.mp3"},{"answer":"I'm feeling quite keen now!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/58.mp3"},{"answer":"How about the pianist on the 22nd of June?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/59.mp3"},{"answer":"Anna Ventura?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/60.mp3"},{"answer":"I've just remembered that's my evening class night.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/61.mp3"},{"answer":"That's okay.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/62.mp3"},{"answer":"I'll just have to go on my own -","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/63.mp3"},{"answer":"but we can go to the Spanish dance and guitar concert together, can't we?","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/64.mp3"},{"answer":"Yes - I'm sure Tom and Kieran would enjoy that too.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/65.mp3"},{"answer":"Good heavens - £10.50 a ticket!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/66.mp3"},{"answer":"I can see we're going to have to go without food for the rest of the week -","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/67.mp3"},{"answer":"we'll need to book four!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/68.mp3"},{"answer":"Wish we were students - look!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/69.mp3"},{"answer":"Children, students and senior citizens get a 50% discount on everything.","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/70.mp3"},{"answer":"If only!","audio":"https://dailydictation.com/upload/ielts-listening/ielts-cambridge-8-test-1-part-1-2023-07-24-23-13-06/71.mp3"}]
