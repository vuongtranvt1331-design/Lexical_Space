[{"answer":"There are four seasons.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/1.mp3"},{"answer":"Winter is the cold season.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/2.mp3"},{"answer":"It snows in the winter.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/3.mp3"},{"answer":"The winds blow,","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/4.mp3"},{"answer":"and ice forms on the water.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/5.mp3"},{"answer":"We play hockey on the ice.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/6.mp3"},{"answer":"We play in the snow.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/7.mp3"},{"answer":"After winter is the spring.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/8.mp3"},{"answer":"That is when it begins to get warmer.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/9.mp3"},{"answer":"Trees get buds on them.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/10.mp3"},{"answer":"Flowers start to bloom.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/11.mp3"},{"answer":"It rains a lot in the spring.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/12.mp3"},{"answer":"Spring is followed by the summer.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/13.mp3"},{"answer":"It can get very hot in the summertime.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/14.mp3"},{"answer":"The sun shines brightly.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/15.mp3"},{"answer":"We go swimming in the summer.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/16.mp3"},{"answer":"We spend a lot of time outdoors.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/17.mp3"},{"answer":"Many people go on vacations in the summer.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/18.mp3"},{"answer":"We get a summer vacation from school.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/19.mp3"},{"answer":"Summer is followed by the fall or autumn.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/20.mp3"},{"answer":"The leaves on the trees change colors.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/21.mp3"},{"answer":"They change from green to red,","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/22.mp3"},{"answer":"orange and brown.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/23.mp3"},{"answer":"The leaves fall off the trees.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/24.mp3"},{"answer":"The weather gets cooler.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/25.mp3"},{"answer":"The days get shorter.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/26.mp3"},{"answer":"We go back to school in the fall.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/27.mp3"},{"answer":"Then, winter comes again.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/28.mp3"},{"answer":"The seasons follow one after each other.","audio":"https://dailydictation.com/upload/general-english/23-seasons-2019-03-20-08-47-09/29.mp3"}]
