[{"answer":"Excuse me. May I see your licence?","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/1.mp3"},{"answer":"I'm afraid I've left it at home.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/2.mp3"},{"answer":"In that case, you'll have to take it to the police station within five days.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/3.mp3"},{"answer":"But why?","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/4.mp3"},{"answer":"You were speeding, ma'am.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/5.mp3"},{"answer":"But I was only doing 75!","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/6-2022-03-10-09-45-35.mp3"},{"answer":"There's a 70km/h speed limit on this road, ma'am.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/7.mp3"},{"answer":"Is there? I didn't see a sign...","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/8.mp3"},{"answer":"Well, ma'am. We've been following you.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/9.mp3"},{"answer":"So you were doing 75, too.","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/10.mp3"},{"answer":"No, ma'am. We were doing 90km/h... and we couldn't catch you!","audio":"https://dailydictation.com/upload/english-conversations/69-traffic-rules-2-2022-03-07-21-27-31/11.mp3"}]
