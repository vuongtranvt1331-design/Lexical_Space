rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      allow read, write: if collection != 'shared_decks';
    }

    match /shared_decks/{deckId} {
      function validDeckId(value) {
        return value.matches('[A-Za-z0-9][A-Za-z0-9_-]{0,127}');
      }

      function validSharedDeck(data) {
        let fields = ['deckId', 'title', 'createdAt', 'wordCount', 'words', 'issuedAt', 'expiresAt'];
        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields)
          && data.deckId is string && validDeckId(data.deckId)
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 200
          && !data.title.matches('\\s*')
          && !data.title.matches('(?i)(all|favorites)')
          && data.createdAt is int
          && data.createdAt >= 0
          && data.createdAt <= 9007199254740991
          && data.wordCount is int
          && data.wordCount > 0
          && data.words is list
          && data.words.size() == data.wordCount;
      }

      function live() {
        return resource.data.expiresAt > request.time
          && resource.data.issuedAt + duration.value(72, 'h') > request.time;
      }
      function validCodeDeck() {
        let data = request.resource.data;
        return deckId.matches('[0-9]{6}') && validSharedDeck(data)
          && data.issuedAt == request.time && data.expiresAt is timestamp
          && data.expiresAt >= request.time + duration.value(72, 'h')
          && data.expiresAt <= request.time + duration.value(4330, 'm');
      }
      allow get: if deckId.matches('[0-9]{6}') && (resource == null || live());
      allow create: if validCodeDeck();
      allow update: if validCodeDeck() && resource.data.issuedAt + duration.value(72, 'h') <= request.time;
      allow list, delete: if false;
    }
  }
}
